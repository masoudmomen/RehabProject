@using Web.Data
@using Rehab.EndPoint.Web.ViewModels
@using Rehab.EndPoint.Web.Helpers
@* Treatment Approaches tab of the "Find Treatment By" mega menu. *@
<MegaMenuPanel Title="Treatment Approaches"
               Subtitle="Explore evidence-based treatment options and approaches for lasting recovery."
               HeaderIcon="sprout"
               ListId="mm-treatments-list"
               SearchPlaceholder="Search treatment approaches..."
               EmptyText="No treatment approaches match your search."
               Columns="2"
               ViewAllText="View all treatment approaches"
               ViewAllHref="/TreatmentsList"
               AsideIcon="flower"
               AsideTitle="Evidence-based care. Lasting recovery."
               AsideText="Explore treatment approaches that work for you.">
    @foreach (var card in TreatmentCards)
    {
        <MegaMenuItem Name="@card.Name"
                      Href="@card.Link"
                      Target="_blank"
                      Icon="@IconFor(card.Name)" />
    }
</MegaMenuPanel>

@code {
    private List<CardViewModel> TreatmentCards = new();
    protected override void OnInitialized()
    {
        TreatmentCards = Treatments.All.OrderBy(i => i.Order).Select(i => new CardViewModel
            {
                Name = i.Name,
                Image = i.Image,
                Link = "/treatment-centers?treatment=" + @Uri.EscapeDataString(i.Name)

            }).ToList();
    }

    // Presentation only: which Lucide icon represents each treatment approach.
    private static readonly Dictionary<string, string> Icons = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Medication-Assisted Treatment (MAT)"] = "pill",
        ["Contingency Management (CM)"] = "award",
        ["Cognitive Behavioral Therapy (CBT)"] = "brain",
        ["Motivational Interviewing (MI)"] = "message-circle-heart",
        ["1-on-1 Counseling"] = "user-round",
        ["Group Therapy"] = "users",
        ["Family Therapy"] = "users-round",
        ["Relapse Prevention Counseling"] = "shield-check",
        ["Trauma-Specific Therapy"] = "shield-plus",
        ["Dialectical Behavior Therapy (DBT)"] = "scale",
        ["EMDR Therapy"] = "eye",
        ["Twelve Step Facilitation (TSF)"] = "footprints",
        ["Psychoeducation / Didactic Group Therapy"] = "book-open",
        ["Meditation & Mindfulness"] = "leaf",
        ["Life Skills"] = "wrench",
    };

    private static string IconFor(string name) =>
        LucideIcons.Resolve(Icons, name, nameof(TreatmentsListComponent));

    // Development startup check (Program.cs): every treatment has an icon and every icon is in the sprite.
    internal static void ValidateIcons() =>
        LucideIcons.ValidateMap(nameof(TreatmentsListComponent), Icons, Treatments.All.Select(i => i.Name));
}
