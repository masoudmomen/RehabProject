@using Microsoft.AspNetCore.Components
@rendermode InteractiveServer
@using Rehab.Application.Email
@using Rehab.EndPoint.Web.ViewModels
@using Rehab.Application.Common
@using Rehab.Application.Packages
@using Rehab.Application.PaymentLinks
@using Microsoft.Extensions.Options
@using Rehab.Application.Stripe
@using AutoMapper
@using Rehab.Domain.Packages.Enums
@inject NavigationManager Navigation
@inject IEmailService EmailService
@inject IOptions<PaymentLinksOptions> PaymentLinksOptions
@inject IConfiguration Config
@inject IPackageRequestService PackageService
@inject IPaymentLinkService PaymentLinkService
@inject IPackagePricingService PackagePricingService
@inject IStripeService StripeService
@inject IMapper mapper
@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4">

                @if (!isSuccess)
                {
                    <!-- FORM VIEW -->
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div>
                                <h5 class="modal-title fw-500 mb-0">Request access | @PackageType.ToString() - @BillingType</h5>
                                <p class="text-muted mb-0" style="font-size:0.8rem;">
                                    Fill in your details and we'll send you a payment link
                                </p>
                            </div>
                            <button type="button" class="btn-close" @onclick="Close"></button>
                        </div>
                        @* <div class="mb-3 mt-3">
                            <span class="pkg-pill" id="pkgPill">@PackageName @PackagePrice</span>
                        </div> *@
                        <hr />
                        <div class="plan-summary">
                            <div class="plan-summary__header">
                                <p class="plan-summary__name">@PackageType.ToString() Plan</p>
                                <span class="plan-summary__badge">@BillingType Billing</span>
                            </div>
                            <div class="plan-summary__price">
                                <span class="plan-summary__amount">@amount</span>
                                <span class="plan-summary__period">/@BillingType</span>
                            </div>
                        </div>

                        <EditForm Model="model" OnValidSubmit="SubmitAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="row g-2 mb-2">

                                <label class="form-label">First Name</label>
                                <InputText class="form-control" @bind-value="model.FirstName" placeholder="Name" />

                                @* <div class="col-6">
                                    <label class="form-label">Last Name</label>
                                    <InputText class="form-control" @bind-value="model.LastName" placeholder="Smith" />
                                </div> *@
                            </div>

                            <div class="mb-2">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" type="email" @bind-value="model.Email" placeholder="yourname@example.com" />
                            </div>

                            <div class="mb-2">
                                <label class="form-label">Phone</label>
                                <InputText class="form-control" @bind-value="model.PhoneNumber" placeholder="123 456 7890" />
                               @*  <ValidationMessage For="() => model.PhoneNumber" /> *@
                            </div>

                            <div class="mb-2">
                                <label class="form-label">Facility Name</label>
                                <InputText class="form-control" @bind-value="model.CenterName" placeholder="Recovery Center Name" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Message</label>
                                <InputTextArea class="form-control" @bind-value="model.Message" placeholder="Tell us a bit about your center or any questions you have..."></InputTextArea>
                            </div>
                            @if (PackageType == PackageType.Enterprise)
                            {
                                <div class="info-box mb-3">
                                    <div class="info-icon">i</div>
                                    <p class="info-text">After submitting, our team will review your request and send a secure payment link to your email within 1 business day.</p>
                                </div>
                            }
                            <button class="btn-submit" type="submit" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span>Sending...</span>
                                }
                                else
                                {
                                    <span>Submit request</span>
                                }
                            </button>
                        </EditForm>
                    </div>

                }
                else
                {
                    @if (PackageType == PackageType.Enterprise)
                    {
                        <!-- SUCCESS VIEW -->
                        <div class="text-center py-3">
                            <div class="success-icon"></div>

                            <h5 class="fw-500 mb-2">Request received!</h5>

                            <p class="text-muted mb-4" style="font-size:0.85rem;">
                                Thank you for your interest in <strong>@PackageType.ToString()</strong><br />
                                We will contact you soon.
                            </p>

                            <button class="btn-pkg" @onclick="Close">
                                Close
                            </button>
                        </div>
                    }

                }

            </div>
        </div>
    </div>
}
@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public PackageType PackageType { get; set; }
    [Parameter] public BillingType BillingType { get; set; }

    // [Parameter] public EventCallback<PackageRequestViewModel> OnSubmit { get; set; }

    private PackageRequestViewModel model = new();
    private bool isLoading = false;
    private bool isSuccess = false;
    private decimal price = 0;
    private decimal amount;

    protected override async Task OnParametersSetAsync()
    {
        if (PackageType == PackageType.Essential || PackageType == PackageType.Premium)
        {
            price = await PackagePricingService.GetPriceAsync(PackageType, BillingType);
            amount = price;

            // if (BillingType == BillingType.Annually)
            // {
            //     amount *= 12;
            // }
        }
    }
    private async Task SubmitAsync()
    {

        isLoading = true;
        model.PackageType = PackageType;
        model.BillingType = BillingType;
        string admin = Config["Email:ToAdmin"];
        if (string.IsNullOrWhiteSpace(model.FirstName) ||
            string.IsNullOrWhiteSpace(model.Email))
        {

            isLoading = false;
            return;
        }

        var requestDto = mapper.Map<PackageRequestDto>(model);
        var addResult = PackageService.Add(requestDto);
        var packageRequest = addResult.Data;
        if (!addResult.Success)
        {
            isLoading = false;
            return;
        }
        if (PackageType == PackageType.Enterprise)
        {
            if (!string.IsNullOrWhiteSpace(admin))
            {
                await EmailService.SendEmailAsync(
                    to: [admin, "maghsoudloo.h.a@gmail.com", "maryam.s.nabavi@gmail.com", "masoudmomen@hotmail.com"],
                    subject: "New Package Request",
                    body: EmailTemplates.BuildPaymentConfirmationAdminEmailBody(model.FirstName, model.LastName, PackageType.ToString(), model.PhoneNumber, model.Email, model.CenterName, model.Message)
                );
                await EmailService.SendEmailAsync(
                    to: [model.Email, "masoudmomen@hotmail.com", "maryam.s.nabavi@gmail.com"],
                    subject: "Your Package Request Has Been Received – RehabNavigator",
                    body: EmailTemplates.BuildPaymentConfirmationEmailBody(model.FirstName, model.LastName, PackageType.ToString(), model.CenterName)
                );
            }
            isLoading = false;
            isSuccess = true;
        }
        else if (PackageType == PackageType.Premium || PackageType == PackageType.Essential)
        {
            if (packageRequest != null)
            {
                       
            
                PaymentLinkDto paymentLink = new PaymentLinkDto();
                paymentLink.PackageRequestId = packageRequest.Id;
                paymentLink.LinkExpiresAt = DateTime.Now.AddMinutes(30);
                paymentLink.Amount = amount;
                // paymentLink.StripeCustomerId = customer.Id;
                var result = await PaymentLinkService.CreateAsync(paymentLink);
                if (result.Data != null)
                {
                    var token = result.Data.Token;
                    var displayPaymentUrl = PaymentLinkAddressBuilder.BuildCustomerPayPageUrl(
                                PaymentLinksOptions.Value.PublicWebBaseUrl,
                                token);
                    Navigation.NavigateTo(displayPaymentUrl);
                }
            }
        }
    }

    private static string NormalizePackageType(string packageName)
    {
        return packageName switch
        {
            "Premium+" => "PremiumPlus",
            _ => packageName
        };
    }

   
    private async Task Close()
    {
        isSuccess = false;
        model = new();

        await VisibleChanged.InvokeAsync(false);
    }

}
