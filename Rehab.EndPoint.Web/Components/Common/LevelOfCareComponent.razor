@using Web.Data
@using Rehab.EndPoint.Web.ViewModels
@* Levels Of Care tab of the "Find Treatment By" mega menu. *@
<MegaMenuPanel Title="Levels Of Care"
               Subtitle="Find the right level of care for your needs and situation."
               HeaderIcon="stethoscope"
               ListId="mm-loc-list"
               SearchPlaceholder="Search levels of care..."
               EmptyText="No levels of care match your search."
               Columns="2"
               AsideIcon="layers"
               AsideTitle="Different needs. Different levels."
               AsideText="Explore treatment levels and find the right care for your recovery journey.">
    @foreach (var card in LevelOfCareCards)
    {
        <MegaMenuItem Name="@card.Name"
                      Description="@card.Description"
                      Href="@card.Link"
                      Target="_blank"
                      Icon="@IconFor(card.Name)" />
    }
</MegaMenuPanel>

@code {
    private List<CardViewModel> LevelOfCareCards = new();
    protected override void OnInitialized()
    {
        LevelOfCareCards = LevelOfCareList.All.Select(i => new CardViewModel
            {
                Name = i.Name,
                Image = i.Image,
                Description = i.Description,
                Link = "/treatment-centers?loc=" + @Uri.EscapeDataString(i.Name)

            }).ToList();
    }

    // Presentation only: which Lucide icon represents each level of care.
    private static readonly Dictionary<string, string> Icons = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Detox / Withdrawal Management"] = "droplets",
        ["Residential Treatment"] = "house",
        ["Intensive Inpatient Treatment"] = "hospital",
        ["Day Treatment / Partial Hospitalization Program (PHP)"] = "calendar-days",
        ["Intensive Outpatient Program (IOP)"] = "calendar-clock",
        ["Outpatient Treatment"] = "building-2",
        ["Virtual Treatment"] = "monitor-smartphone",
        ["Sober Living / Recovery Housing"] = "house-plus",
        ["Co-Occurring Disorder Treatment"] = "git-merge",
        ["Primary Mental Health Treatment"] = "brain",
        ["Concierge Treatment"] = "concierge-bell",
        ["Co-Occurring Mental Health Treatment"] = "brain-circuit",
        ["Co-Occurring Substance Use Treatment"] = "pill",
        ["In-Home Treatment"] = "house-heart",
        ["Intensive Family Program"] = "users",
        ["Interventionists"] = "hand-helping",
        ["Outpatient Therapy"] = "messages-square",
        ["Private Therapy"] = "user-round",
        ["Recovery Coaching"] = "compass",
        ["Recovery School"] = "graduation-cap",
        ["Retreat Programs"] = "tent-tree",
        ["Sober Companion"] = "hand-heart",
        ["Therapeutic Boarding School"] = "school",
    };

    private static string IconFor(string name) =>
        Icons.TryGetValue(name, out var icon) ? icon : "circle-help";
}
