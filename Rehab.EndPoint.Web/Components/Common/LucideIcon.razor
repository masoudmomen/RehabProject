@* Renders a Lucide icon (https://lucide.dev) from the local sprite at
   wwwroot/icons/lucide-sprite.svg. Stroke uses currentColor, so colour it
   with CSS `color`. To add an icon, append its <symbol> to the sprite. *@
<svg class="lucide @Class" width="@Size" height="@Size" aria-hidden="true" focusable="false">
    <use href="/icons/lucide-sprite.svg#@Name"></use>
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "circle-help";
    [Parameter] public string? Class { get; set; }
    [Parameter] public int Size { get; set; } = 18;
}
