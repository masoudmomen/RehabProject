<div class="provider-card mt-3">
    <p class="card-title">For Providers</p>
    <p class="card-desc">Manage your facility profile or explore advertising options for greater visibility.</p>
    @*     <button class="btn-primary">Claim Your Profile</button>
 *@    <a href="/advertise-with-us/plans" class="btn-primary text-decoration-none"  target="_blank">Advertise With Us</a>
</div>

@code {
    // Set on a state page (name or URL slug) to swap the popular states for the other states in its region
    [Parameter]
    public string? State { get; set; }

    private Rehab.EndPoint.Web.Data.USState? CurrentState;
    private List<Rehab.EndPoint.Web.Data.USState> RegionStates = new();

    protected override void OnParametersSet()
    {
        var name = State?.Trim().Replace("-", " ");
        CurrentState = string.IsNullOrWhiteSpace(name)
            ? null
            : Rehab.EndPoint.Web.Data.USStates.All.FirstOrDefault(s => s.Name.Equals(name, StringComparison.OrdinalIgnoreCase));

        RegionStates = CurrentState is null
            ? new()
            : Rehab.EndPoint.Web.Data.USStates.All
                .Where(s => s.Region == CurrentState.Region && s != CurrentState)
                .OrderBy(s => s.Name)
                .ToList();
    }
}