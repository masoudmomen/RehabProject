@using Rehab.EndPoint.Web.Components.Facility
<section class="fbs">
    <div class="container fbs-container">
        <header class="fbs-header">
            <span class="fbs-accent" aria-hidden="true"><span></span><span></span></span>
            <h2 class="section-title fbs-title">Browse Rehab Centers by <span class="title-highlight">State</span></h2>
            <p class="fbs-subtitle">Select a state to explore rehab centers by condition, level of care, insurance information, and facility information.</p>
        </header>
        <div class="fbs-grid">
            <div class="fbs-card fbs-card-map">
                <StatesMap />
            </div>
            <div class="fbs-card fbs-card-browse">
                <StateByAlphabet></StateByAlphabet>
            </div>
        </div>
    </div>
</section>
@* Global on purpose: other home sections (WWT, Treatment, Conditions, ...) rely on these two rules. *@
<style>
    .bg-light-gray{
        background-color: #eee;
    }
    h2.section-title {
        font-weight: 700;
        background: linear-gradient(270deg, #063d8d, #5e388b, #7b1573);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: fadeInUp 1s ease-out;
    }


</style>
