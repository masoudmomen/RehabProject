@page "/treatment-centers"
@rendermode InteractiveServer
@using Rehab.Application.Facilities
@using Rehab.EndPoint.AdminPanel.CommonService
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.EndPoint.Web.Components.Facility
@using Rehab.EndPoint.Web.ViewModels
@using System.Threading.Tasks
@inject IFacilityService FacilityService
@inject AutoMapper.IMapper mapper
@inject InternalLocationService InternalLocationService
@inject IJSRuntime JS
@using Rehab.Application.Seo
@inject ISeoService SeoService


<HeadContent>
    <meta name="keywords" content="@Keywords" />
    <meta name="description" content="@Description" />
</HeadContent>

<div class="container">
      <HeroSectionComponent 
        SectionTitle="Browse Treatment Centers and Rehab Facility Profiles"
        SectionSubtitle="Search treatment centers by state, city, condition, level of care, insurance, treatment approach, age group, and amenities."
        />
    
    <input type="checkbox" id="sidebarToggle" hidden />
  @*   <input type="checkbox" id="sidebarToggle" hidden /> *@
    <div class="sidebar-overlay"></div>
    <div class="row my-4 layout-wrapper"
         id="facilitypage">
        <div class="content-a">
            <TreatmentCenterFilter @bind-Filters="FullFacilityFilterItems"
                                   Fields="Fields"
                                   States="States"
                                   Cities="Cities"
                                   OnStatesChanged="HandleCities"
                                   OnSearch="ApplyFilter" />
            <div class="results-filters tc-results">
                <h2 class="tc-results-title">
                    <strong>@TotalCount.ToString("N0") treatment @(TotalCount == 1 ? "center" : "centers")</strong>
                    @if (ResultsFiltered)
                    {
                        <span class="mx-1">match your search</span>
                    }
                </h2>
                <p class="tc-results-sub">Explore facility profiles, locations, services, insurance information, and treatment options.</p>
            </div>
            <div class="container px-0 mb-5">
                <div class="row g-4">
                    @foreach (var facility in FacilityCards)
                    {
                        <div class="col-md-4 mb-3">
                            <FacilityItem ShowTags="false" FacilityCard="facility" CustomClass="small-card" />
                        </div>
                    }
                </div>
                @if (IsLoading)
                {
                    <p>Loading...</p>
                }

                <div id="scrollTrigger"></div>

            </div>
        </div>
        <div class="content-b">
           <SidebarComponent />
        </div>
    </div>
   
</div>
 
@code {
    //infinite scroll
    //----------------------------------------------------------

    private List<FacilityCardViewmodel> FacilityCards = new();
    private int page = 1;
    private int pageSize = 12;
    private bool IsLoading = false;
    private bool HasMore = true;

    private string? Keywords;
    private string? Description;
    private void LoadMeta()
    {
        var Meta = SeoService.GetMeta("Facilities");

        if (Meta != null)
        {
            if (Meta.Keywords != null)
                Keywords = string.Join(",", Meta.Keywords);

            Description = Meta.Description;
        }
    }
    private DotNetObjectReference<TreatmentCenters>? objRefState;

    protected override async Task OnInitializedAsync()
    {
        LoadMeta();

        serverUrl = Config["AppSettings:AdminServerUrl"]!;
        States = await InternalLocationService!.GetStateWithoutHttpAsync(serverUrl)!;

        Fields = mapper.Map<FacilityFieldsViewmodel>(FacilityService.GetListFacilityFields());

        #region FilterOperation
        if (!string.IsNullOrWhiteSpace(state))
            FullFacilityFilterItems.States.Add(state);

        if (!string.IsNullOrWhiteSpace(city))
            FullFacilityFilterItems.Cities.Add(city);

        if (!string.IsNullOrWhiteSpace(condition)) 
            FullFacilityFilterItems.Conditions.Add(new ConditionViewModel()
            {
                Name = condition
            });
        if (!string.IsNullOrWhiteSpace(amenity)) 
            FullFacilityFilterItems.Amenities.Add(new AmenityViewmodel()
            {
                Name = amenity
            });
        if (!string.IsNullOrWhiteSpace(treatment))
            FullFacilityFilterItems.Treatments.Add(new TreatmentViewmodel
                {
                    Name = treatment.ToLowerInvariant()
                });
        if (!string.IsNullOrWhiteSpace(insurance))
            FullFacilityFilterItems.Insurances.Add(new InsuranceViewModel
                {
                    Name = insurance
                });

        if (!string.IsNullOrWhiteSpace(loc)) 
            FullFacilityFilterItems.Locs.Add(new LocViewmodel
                {
                    Name = loc
                });
        if (!string.IsNullOrWhiteSpace(wwt)) 
            FullFacilityFilterItems.Wwts.Add(new WwtViewModel
            {
                Name = wwt
            }) ;
        if (!string.IsNullOrWhiteSpace(swt)) 
            FullFacilityFilterItems.Swts.Add(new SwtViewModel
            {
                Name = swt
            }) ;
        #endregion

        await LoadMore();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRefState = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("infiniteScroll.initialize",
                "scrollTrigger",
                objRefState);
        }
    }

    [JSInvokable]
    public async Task LoadMore()
    {
        if (IsLoading || !HasMore)
            return;

        IsLoading = true;
        StateHasChanged();

        var newItems = await FacilityService.GetFacilityCardsAsync(page, pageSize, 
        mapper.Map<FullFacilityFilterItemsDto>(FullFacilityFilterItems));

        if (newItems.Item1.Count < pageSize)
            HasMore = false;

        FacilityCards.AddRange(mapper.Map<List<FacilityCardViewmodel>>(newItems.Item1));
        TotalCount = newItems.totalCount;
        if (page == 1)
            ResultsFiltered = TreatmentCenterFilter.CountPicked(FullFacilityFilterItems) > 0 ||FullFacilityFilterItems.Swts.Count > 0
                || !string.IsNullOrWhiteSpace(FullFacilityFilterItems.SearchText);
        page++;

        IsLoading = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        objRefState?.Dispose();
    }


