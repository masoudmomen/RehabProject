    private async Task HandleCities(List<string> states)
    {
        Cities = await InternalLocationService!.GetCitiesByStatesAsync(serverUrl, states);
    }

    async Task ApplyFilter()
    {
        FacilityCards = new();
        page = 1;
        IsLoading = false;
        HasMore = true;
        await LoadMore();
