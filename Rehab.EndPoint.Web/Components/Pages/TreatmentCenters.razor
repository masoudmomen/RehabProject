        HasMore = true;
        await LoadMore();
    }

    private void Uncheck(string id)
    {
        HandleCheckbox(id, false);
    }


    private void HandleCheckbox(string id, bool state)
    {
        JS.InvokeVoidAsync("setCheckboxState", id, state);
    }

    private void UncheckState(string id)
    {
        HandleCheckboxState(id, false);
        HandleCities();
    }
    private void HandleCheckboxState(string id, bool state)
    {
         JS.InvokeVoidAsync("setCheckboxState", id, state);
    }

    private void UnCheckAll()
    {
         JS.InvokeVoidAsync("UnCheckAllCheckbox");
    }


    // Search & filter UI
    //----------------------------------------------------------

    private int TotalCount;
    private bool ResultsFiltered;
    private bool FilterSheetOpen;

    private int LocationCount => FullFacilityFilterItems.States.Count + FullFacilityFilterItems.Cities.Count;
    private int MoreFiltersCount => FullFacilityFilterItems.Treatments.Count + FullFacilityFilterItems.Amenities.Count;
    private int PickedCount => LocationCount + MoreFiltersCount
        + FullFacilityFilterItems.Conditions.Count + FullFacilityFilterItems.Locs.Count
        + FullFacilityFilterItems.Insurances.Count + FullFacilityFilterItems.Wwts.Count;

    private string? LocationSummary
    {
        get
        {
            var states = FullFacilityFilterItems.States;
            var cities = FullFacilityFilterItems.Cities;
            if (cities.Count == 1 && states.Count == 1) return $"{cities[0]}, {states[0]}";
            var picks = cities.Count > 0 ? cities : states;
            if (picks.Count == 0) return null;
            return picks.Count == 1 ? picks[0] : $"{picks[0]} +{picks.Count - 1}";
        }
    }

    private static string Summary(IEnumerable<string> names)
    {
        var text = string.Join(", ", names);
        return text.Length == 0 ? "Any" : text;
    }

    private void ClearGroup<T>(List<T> picked, Func<T, string> checkboxId)
    {
        foreach (var item in picked)
            Uncheck(checkboxId(item));
        picked.Clear();
    }

    private void ClearLocation()
    {
        foreach (var item in FullFacilityFilterItems.States.Concat(FullFacilityFilterItems.Cities))
            HandleCheckboxState(item, false);
        FullFacilityFilterItems.States.Clear();
        FullFacilityFilterItems.Cities.Clear();
        HandleCities();
    }

    private RenderFragment PanelHead(string title, int selected) => __builder =>
    {
        <div class="tc-panel-head">
            <span class="tc-panel-title">@title</span>
            @if (selected > 0)
            {
                <span class="tc-panel-meta">@selected selected</span>
            }
        </div>
    };

    private RenderFragment PanelSearch(string placeholder) => __builder =>
    {
        <div class="tc-panel-search">
            <LucideIcon Name="search" Size="16" />
            <input type="text" class="tc-panel-search-input" placeholder="@placeholder" aria-label="@placeholder" />
        </div>
    };

    private RenderFragment PanelFoot(Action clear) => __builder =>
    {
        <div class="tc-panel-foot">
            <button type="button" class="tc-link-btn" @onclick="clear">Clear</button>
            <button type="button" class="tc-apply-btn" data-tc-close="true" @onclick="ApplyFilter">Show centers</button>
        </div>
    };

}



<script>
    // Dropdowns stay open while ticking (data-bs-auto-close="outside");
    // "Show centers" and the sheet buttons close any that are open.
    if (!window.tcFiltersCloseBound) {
        window.tcFiltersCloseBound = true;
        document.addEventListener('click', e => {
            if (!e.target.closest('[data-tc-close]') || !window.bootstrap) return;
            document.querySelectorAll('.tc-search [data-bs-toggle="dropdown"].show').forEach(toggle =>
                bootstrap.Dropdown.getOrCreateInstance(toggle).hide());
        });
    }
</script>