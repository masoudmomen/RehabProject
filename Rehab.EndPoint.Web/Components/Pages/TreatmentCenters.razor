    private async void StateToggleSelectItems(string selectedItem)
    {
        if (FullFacilityFilterItems.States.Contains(selectedItem)) FullFacilityFilterItems.States.Remove(selectedItem);
        else FullFacilityFilterItems.States.Add(selectedItem);

        HandleCities();
    }

    private async void HandleCities()
    {
        Cities = await InternalLocationService!.GetCitiesByStatesAsync(serverUrl, FullFacilityFilterItems.States!);
        StateHasChanged();
    }

    private void CityToggleSelectItems(string selectedItem)
