@page "/treatment-centers"
@rendermode InteractiveServer
@using Rehab.Application.Facilities
@using Rehab.EndPoint.AdminPanel.CommonService
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.EndPoint.Web.Components.Facility
@using Rehab.EndPoint.Web.ViewModels
@using System.Threading.Tasks
@inject IFacilityService FacilityService
@inject AutoMapper.IMapper mapper
@inject InternalLocationService InternalLocationService
@inject IJSRuntime JS
@using Rehab.Application.Seo
@inject ISeoService SeoService


<HeadContent>
    <meta name="keywords" content="@Keywords" />
    <meta name="description" content="@Description" />
</HeadContent>

<div class="container">
      <HeroSectionComponent 
        SectionTitle="Browse Treatment Centers and Rehab Facility Profiles"
        SectionSubtitle="Search treatment centers by state, city, condition, level of care, insurance, treatment approach, age group, and amenities."
        />
    
    <input type="checkbox" id="sidebarToggle" hidden />
  @*   <input type="checkbox" id="sidebarToggle" hidden /> *@
    <div class="sidebar-overlay"></div>
    <div class="row my-4 layout-wrapper" id="facilitypage">
        <div class="content-a">
            <section id="searchbox" class="tc-search @(FilterSheetOpen ? "is-sheet-open" : "")" aria-label="Search and filter treatment centers">

                <!-- Search bar: center name + location -->
                <div class="tc-searchbar">
                    <label class="tc-field tc-field--name">
                        <span class="tc-field-icon"><LucideIcon Name="search" Size="20" /></span>
                        <span class="tc-field-body">
                            <span class="tc-field-label">Center name</span>
                            <input type="text" @bind-value="FullFacilityFilterItems.SearchText"
                                   class="tc-field-input"
                                   placeholder="Search by name" />
                        </span>
                    </label>

                    <!-- Location (States + Cities) Dropdown -->
                    <div class="dropdown tc-field tc-field--location @(LocationCount > 0 ? "has-value" : "")">
                        <button class="tc-field-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-display="static"
                                data-bs-auto-close="outside"
                                aria-expanded="false">
                            <span class="tc-field-icon"><LucideIcon Name="map-pin" Size="20" /></span>
                            <span class="tc-field-body">
                                <span class="tc-field-label">Location</span>
                                <span class="tc-field-value">@(LocationSummary ?? "Any state or city")</span>
                            </span>
                            <span class="tc-chevron"><LucideIcon Name="chevron-down" Size="18" /></span>
                        </button>
                        <span class="tc-dd-backdrop" aria-hidden="true"></span>

                        <div class="dropdown-menu tc-panel tc-panel--location">
                            <div class="tc-panel-cols">
                                <div class="tc-panel-col">
                                    @PanelHead("State", FullFacilityFilterItems.States.Count)
                                    @PanelSearch("Search states")
                                    <ul class="tc-options">
                                        @if (States != null)
                                        {
                                            @foreach (var item in States)
                                            {
                                                <li @onmousedown="()=>StateToggleSelectItems(item)">
                                                    <label class="dropdown-item tc-option">
                                                        <input type="checkbox" value="@item" id="@item">
                                                        <span class="tc-option-text">@item</span>
                                                    </label>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                                <div class="tc-panel-col">
                                    @PanelHead(FullFacilityFilterItems.States.Count == 1 ? $"City in {FullFacilityFilterItems.States[0]}" : "City", FullFacilityFilterItems.Cities.Count)
                                    @PanelSearch("Search cities")
                                    @if (Cities != null && Cities.Count > 0)
                                    {
                                        <ul class="tc-options">
                                            @foreach (var item in Cities)
                                            {
                                                <li @onmousedown="()=>CityToggleSelectItems(item)">
                                                    <label class="dropdown-item tc-option">
                                                        <input type="checkbox" value="@item" id="@item">
                                                        <span class="tc-option-text">@item</span>
                                                    </label>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="tc-panel-hint">Pick a state to see its cities.</p>
                                    }
                                </div>
                            </div>
                            @PanelFoot(ClearLocation)
                        </div>

                        @if (LocationCount > 0)
                        {
                            <button type="button" class="tc-field-clear" aria-label="Clear location" @onclick="ClearLocation">
                                <LucideIcon Name="x" Size="14" />
                            </button>
                        }
                    </div>

                    <button type="button" class="tc-search-btn" @onclick="ApplyFilter">
                        <LucideIcon Name="search" Size="18" />
                        <span>Search</span>
                    </button>
                </div>

                <!-- Filter buttons (on phones this row becomes the Filters sheet) -->
                <div class="tc-filter-row">
                    <div class="tc-sheet-head">
                        <div>
                            <h2 class="tc-sheet-title">Filters</h2>
                            <p class="tc-sheet-meta">@(PickedCount > 0 ? $"{PickedCount} on" : "None picked")</p>
                        </div>
                        <button type="button" class="tc-sheet-close" aria-label="Close filters" data-tc-close="true"
                                @onclick="() => FilterSheetOpen = false">
                            <LucideIcon Name="x" Size="20" />
                        </button>
                    </div>

                    <button type="button" class="tc-filters-btn" @onclick="() => FilterSheetOpen = true">
                        <LucideIcon Name="sliders-horizontal" Size="18" />
                        <span>Filters</span>
                        @if (PickedCount > 0)
                        {
                            <span class="tc-count">@PickedCount</span>
                        }
                    </button>

                    <!-- Conditions Dropdown -->
                    <div class="dropdown tc-filter @(FullFacilityFilterItems.Conditions.Count > 0 ? "is-active" : "")">
                        <button class="tc-filter-btn"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-display="static"
                                data-bs-auto-close="outside"
                                aria-expanded="false">
                            <span class="tc-btn-icon"><LucideIcon Name="heart-pulse" Size="18" /></span>
                            <span class="tc-btn-text">
                                <span class="tc-btn-label">Condition</span>
                                <span class="tc-btn-summary">@Summary(FullFacilityFilterItems.Conditions.Select(c => c.Name))</span>
                            </span>
                            @if (FullFacilityFilterItems.Conditions.Count > 0)
                            {
                                <span class="tc-count">@FullFacilityFilterItems.Conditions.Count</span>
                            }
                            <span class="tc-chevron"><LucideIcon Name="chevron-down" Size="16" /></span>
                        </button>
                        <span class="tc-dd-backdrop" aria-hidden="true"></span>

                        <div class="dropdown-menu tc-panel">
                            @PanelHead("Condition", FullFacilityFilterItems.Conditions.Count)
                            @PanelSearch("Search conditions")
                            <ul class="tc-options">
                                @foreach (var item in Fields.Conditions!)
                                {
                                    <li @onmousedown="() => ConditionToggleSelectItems(item)">
                                        <label class="dropdown-item tc-option">
                                            <input type="checkbox" value="@item" id="condition-@item.Id" />
                                            <span class="tc-option-text">@item.Name</span>
                                        </label>
                                    </li>
                                }
                            </ul>
                            @PanelFoot(() => ClearGroup(FullFacilityFilterItems.Conditions, c => "condition-" + c.Id))
                        </div>
                    </div>

                    <!-- LevelOfCare Dropdown -->
                    <div class="dropdown tc-filter @(FullFacilityFilterItems.Locs.Count > 0 ? "is-active" : "")">
                        <button class="tc-filter-btn"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-display="static"
                                data-bs-auto-close="outside"
                                aria-expanded="false">
                            <span class="tc-btn-icon"><LucideIcon Name="hospital" Size="18" /></span>
                            <span class="tc-btn-text">
                                <span class="tc-btn-label">Level of care</span>
                                <span class="tc-btn-summary">@Summary(FullFacilityFilterItems.Locs.Select(l => l.Name))</span>
                            </span>
                            @if (FullFacilityFilterItems.Locs.Count > 0)
                            {
                                <span class="tc-count">@FullFacilityFilterItems.Locs.Count</span>
                            }
                            <span class="tc-chevron"><LucideIcon Name="chevron-down" Size="16" /></span>
                        </button>
                        <span class="tc-dd-backdrop" aria-hidden="true"></span>

                        <div class="dropdown-menu tc-panel">
                            @PanelHead("Level of care", FullFacilityFilterItems.Locs.Count)
                            @PanelSearch("Search levels of care")
                            <ul class="tc-options">
                                @foreach (var item in Fields.Locs!)
                                {
                                    <li @onmousedown="() => LocToggleSelectItems(item)">
                                        <label class="dropdown-item tc-option">
                                            <input type="checkbox" value="@item" id="loc-@item.Id">
                                            <span class="tc-option-text">@item.Name</span>
                                        </label>
                                    </li>
                                }
                            </ul>
                            @PanelFoot(() => ClearGroup(FullFacilityFilterItems.Locs, l => "loc-" + l.Id))
                        </div>
                    </div>

                    <!-- Insurances DropDown -->
                    <div class="dropdown tc-filter @(FullFacilityFilterItems.Insurances.Count > 0 ? "is-active" : "")">
                        <button class="tc-filter-btn"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-display="static"
                                data-bs-auto-close="outside"
                                aria-expanded="false">
                            <span class="tc-btn-icon"><LucideIcon Name="shield-check" Size="18" /></span>
                            <span class="tc-btn-text">
                                <span class="tc-btn-label">Insurance</span>
                                <span class="tc-btn-summary">@Summary(FullFacilityFilterItems.Insurances.Select(i => i.Name))</span>
                            </span>
                            @if (FullFacilityFilterItems.Insurances.Count > 0)
                            {
                                <span class="tc-count">@FullFacilityFilterItems.Insurances.Count</span>
                            }
                            <span class="tc-chevron"><LucideIcon Name="chevron-down" Size="16" /></span>
                        </button>
                        <span class="tc-dd-backdrop" aria-hidden="true"></span>

                        <div class="dropdown-menu tc-panel">
                            @PanelHead("Insurance", FullFacilityFilterItems.Insurances.Count)
                            @PanelSearch("Search insurance")
                            <ul class="tc-options">
                                @foreach (var item in Fields.Insurances!)
                                {
                                    <li @onmousedown="() => InsuranceToggleSelectItems(item)">
                                        <label class="dropdown-item tc-option">
                                            <input type="checkbox" value="@item" id="insurance-@item.Id">
                                            <span class="tc-option-text">@item.Name</span>
                                        </label>
                                    </li>
                                }
                            </ul>
                            @PanelFoot(() => ClearGroup(FullFacilityFilterItems.Insurances, i => "insurance-" + i.Id))
                        </div>
                    </div>

                    <!-- Who We Treat Dropdown -->
                    <div class="dropdown tc-filter @(FullFacilityFilterItems.Wwts.Count > 0 ? "is-active" : "")">
                        <button class="tc-filter-btn"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-display="static"
                                data-bs-auto-close="outside"
                                aria-expanded="false">
                            <span class="tc-btn-icon"><LucideIcon Name="users" Size="18" /></span>
                            <span class="tc-btn-text">
                                <span class="tc-btn-label">Age &amp; population</span>
                                <span class="tc-btn-summary">@Summary(FullFacilityFilterItems.Wwts.Select(w => w.Name))</span>
                            </span>
                            @if (FullFacilityFilterItems.Wwts.Count > 0)
                            {
                                <span class="tc-count">@FullFacilityFilterItems.Wwts.Count</span>
                            }
                            <span class="tc-chevron"><LucideIcon Name="chevron-down" Size="16" /></span>
                        </button>
                        <span class="tc-dd-backdrop" aria-hidden="true"></span>

                        <div class="dropdown-menu tc-panel">
                            @PanelHead("Age & population", FullFacilityFilterItems.Wwts.Count)
                            @PanelSearch("Search age groups")
                            <ul class="tc-options">
                                @foreach (var item in Fields.Wwts!)
                                {
                                    <li @onmousedown="() => WwtToggleSelectItems(item)">
                                        <label class="dropdown-item tc-option">
                                            <input type="checkbox" value="@item" id="wwt-@item.Id">
                                            <span class="tc-option-text">@item.Name</span>
                                        </label>
                                    </li>
                                }
                            </ul>
                            @PanelFoot(() => ClearGroup(FullFacilityFilterItems.Wwts, w => "wwt-" + w.Id))
                        </div>
                    </div>

                    <!-- More filters: Treatments + Amenities -->
                    <div class="dropdown tc-filter @(MoreFiltersCount > 0 ? "is-active" : "")">
                        @* Positioned by Popper (not static) so the wide panel opens under this
                           button and shifts sideways only if it would leave the screen. *@
                        <button class="tc-filter-btn"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                data-bs-popper-config='{"modifiers":[{"name":"flip","enabled":false}]}'
                                aria-expanded="false">
                            <span class="tc-btn-icon"><LucideIcon Name="sliders-horizontal" Size="18" /></span>
                            <span class="tc-btn-text">
                                <span class="tc-btn-label">More filters</span>
                                <span class="tc-btn-summary">@Summary(FullFacilityFilterItems.Treatments.Select(t => t.Name).Concat(FullFacilityFilterItems.Amenities.Select(a => a.Name)))</span>
                            </span>
                            @if (MoreFiltersCount > 0)
                            {
                                <span class="tc-count">@MoreFiltersCount</span>
                            }
                            <span class="tc-chevron"><LucideIcon Name="chevron-down" Size="16" /></span>
                        </button>
                        <span class="tc-dd-backdrop" aria-hidden="true"></span>

                        <div class="dropdown-menu tc-panel tc-panel--more">
                            <div class="tc-panel-cols">
                                <!-- Treatments -->
                                <div class="tc-panel-col">
                                    @PanelHead("Treatment approach", FullFacilityFilterItems.Treatments.Count)
                                    @PanelSearch("Search treatments")
                                    <ul class="tc-options">
                                        @foreach (var item in Fields.Treatments!)
                                        {
                                            <li @onmousedown="() => TreatmentToggleSelectItems(item)">
                                                <label class="dropdown-item tc-option">
                                                    <input type="checkbox" value="@item" id="treatment-@item.Id">
                                                    <span class="tc-option-text">@item.Name</span>
                                                </label>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <!-- Amenities -->
                                <div class="tc-panel-col">
                                    @PanelHead("Amenities", FullFacilityFilterItems.Amenities.Count)
                                    @PanelSearch("Search amenities")
                                    <ul class="tc-options">
                                        @foreach (var item in Fields.Amenities!)
                                        {
                                            <li @onmousedown="() => AmenityToggleSelectItems(item)">
                                                <label class="dropdown-item tc-option">
                                                    <input type="checkbox" value="@item" id="amenity-@item.Id">
                                                    <span class="tc-option-text">@item.Name</span>
                                                </label>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                            @PanelFoot(() =>
                            {
                                ClearGroup(FullFacilityFilterItems.Treatments, t => "treatment-" + t.Id);
                                ClearGroup(FullFacilityFilterItems.Amenities, a => "amenity-" + a.Id);
                            })
                        </div>
                    </div>

                    <div class="tc-sheet-foot">
                        <button type="button" class="tc-link-btn"
                                @onclick="() => { FullFacilityFilterItems = new();UnCheckAll();HandleCities(); }">
                            Clear all
                        </button>
                        <button type="button" class="tc-apply-btn tc-apply-btn--lg" data-tc-close="true"
                                @onclick="async () => { FilterSheetOpen = false; await ApplyFilter(); }">
                            Show centers
                        </button>
                    </div>
                </div>

                @if (FilterSheetOpen)
                {
                    <div class="tc-sheet-backdrop" data-tc-close="true" @onclick="() => FilterSheetOpen = false"></div>
                }

                <!-- Picked filters as chips (only once something is picked) -->
                @if (PickedCount > 0 || FullFacilityFilterItems.Swts.Count > 0)
                {
                    <div class="tc-chips">
                        <ul class="tc-chip-list" aria-label="Picked filters">
                            @foreach (var item in FullFacilityFilterItems.States)
                            {
                                <li class="tc-chip">
                                    @item
                                    <button type="button" class="tc-chip-remove" aria-label="Remove @item"
                                    @onclick="()=>{
                                        FullFacilityFilterItems.States.Remove(item);
                                        UncheckState(item);}" ><LucideIcon Name="x" Size="14" /></button>
                                </li>
                            }

                            @foreach (var item in FullFacilityFilterItems.Cities)
                            {
                                <li class="tc-chip">
                                    @item
                                    <button type="button" class="tc-chip-remove" aria-label="Remove @item"
                                    @onclick="()=>{
                                        FullFacilityFilterItems.Cities.Remove(item);
                                        UncheckState(item);}" ><LucideIcon Name="x" Size="14" /></button>
                                </li>
                            }

                            @foreach (var item in FullFacilityFilterItems.Conditions)
                            {
                                string tagId = "condition-" + item.Id.ToString();
                                <li class="tc-chip">
                                    @item.Name
                                    <button type="button" class="tc-chip-remove" aria-label="Remove @item.Name"
                                            @onclick="() => {
                                            FullFacilityFilterItems.Conditions.Remove(item);
                                                Uncheck(tagId);}">
                                        <LucideIcon Name="x" Size="14" />
                                    </button>
                                </li>
                            }

                            @foreach (var item in FullFacilityFilterItems.Locs)
                            {
                                string tagId = "loc-" + item.Id.ToString();
                                <li class="tc-chip">
                                    @item.Name
                                    <button type="button" class="tc-chip-remove" aria-label="Remove @item.Name"
                                            @onclick="() => { FullFacilityFilterItems.Locs.Remove(item);
                                            Uncheck(tagId);}">
                                        <LucideIcon Name="x" Size="14" />
                                    </button>
                                </li>
                            }

                            @foreach (var item in FullFacilityFilterItems.Insurances)
                            {
                                string tagId = "insurance-" + item.Id.ToString();
                                <li class="tc-chip">
                                    @item.Name
                                    <button type="button" class="tc-chip-remove" aria-label="Remove @item.Name"
                                            @onclick="() => { FullFacilityFilterItems.Insurances.Remove(item);
                                            Uncheck(tagId);}">
                                        <LucideIcon Name="x" Size="14" />
                                    </button>
                                </li>
                            }

                            @foreach (var item in FullFacilityFilterItems.Wwts)
                            {
                                string tagId = "wwt-" + item.Id.ToString();
                                <li class="tc-chip">
                                    @item.Name
                                    <button type="button" class="tc-chip-remove" aria-label="Remove @item.Name"
                                            @onclick="() => { FullFacilityFilterItems.Wwts.Remove(item);
                                            Uncheck(tagId);}">
                                        <LucideIcon Name="x" Size="14" />
                                    </button>
                                </li>
                            }

                            @foreach (var item in FullFacilityFilterItems.Treatments)
                            {
                                string tagId = "treatment-" + item.Id.ToString();
                                <li class="tc-chip">
                                    @item.Name
                                    <button type="button" class="tc-chip-remove" aria-label="Remove @item.Name"
                                            @onclick="() => { FullFacilityFilterItems.Treatments.Remove(item);
                                            Uncheck(tagId);}">
                                        <LucideIcon Name="x" Size="14" />
                                    </button>
                                </li>
                            }

                            @foreach (var item in FullFacilityFilterItems.Amenities)
                            {
                                string tagId = "amenity-" + item.Id.ToString();
                                <li class="tc-chip">
                                    @item.Name
                                    <button type="button" class="tc-chip-remove" aria-label="Remove @item.Name"
                                            @onclick="() => { FullFacilityFilterItems.Amenities.Remove(item);
                                            Uncheck(tagId);}">
                                        <LucideIcon Name="x" Size="14" />
                                    </button>
                                </li>
                            }
                        </ul>

                        <button class="tc-clear-all" type="button"
                                @onclick="() => { FullFacilityFilterItems = new();UnCheckAll();HandleCities(); }">
                            <LucideIcon Name="rotate-ccw" Size="16" />
                            Clear all
                        </button>
                    </div>
                }
            </section>
            <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@*                 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
 *@
            <div class="results-filters tc-results">
                <h2 class="tc-results-title">
                    <strong>@TotalCount.ToString("N0") treatment @(TotalCount == 1 ? "center" : "centers")</strong>
                    @if (ResultsFiltered)
                    {
                        <span>match your search</span>
                    }
                </h2>
                <p class="tc-results-sub">Explore facility profiles, locations, services, insurance information, and treatment options.</p>
            </div>
            <div class="container px-0 mb-5">
                <div class="row g-4">
                    @foreach (var facility in FacilityCards)
                    {
                        <div class="col-md-4 mb-3">
                            <FacilityItem ShowTags="false" FacilityCard="facility" CustomClass="small-card" />
                        </div>
                    }
                </div>
                @if (IsLoading)
                {
                    <p>Loading...</p>
                }

                <div id="scrollTrigger"></div>

            </div>
        </div>
        <div class="content-b">
           <SidebarComponent />
        </div>
    </div>
   
</div>
 
@code {
    //infinite scroll
    //----------------------------------------------------------

    private List<FacilityCardViewmodel> FacilityCards = new();
    private int page = 1;
    private int pageSize = 12;
    private bool IsLoading = false;
    private bool HasMore = true;

    private string? Keywords;
    private string? Description;
    private void LoadMeta()
    {
        var Meta = SeoService.GetMeta("Facilities");

        if (Meta != null)
        {
            if (Meta.Keywords != null)
                Keywords = string.Join(",", Meta.Keywords);

            Description = Meta.Description;
        }
    }
    private DotNetObjectReference<TreatmentCenters>? objRefState;

    protected override async Task OnInitializedAsync()
    {
        LoadMeta();

        serverUrl = Config["AppSettings:AdminServerUrl"]!;
        States = await InternalLocationService!.GetStateWithoutHttpAsync(serverUrl)!;

        Fields = mapper.Map<FacilityFieldsViewmodel>(FacilityService.GetListFacilityFields());

        #region FilterOperation
        if (!string.IsNullOrWhiteSpace(state))
            FullFacilityFilterItems.States.Add(state);

        if (!string.IsNullOrWhiteSpace(city))
            FullFacilityFilterItems.Cities.Add(city);

        if (!string.IsNullOrWhiteSpace(condition)) 
            FullFacilityFilterItems.Conditions.Add(new ConditionViewModel()
            {
                Name = condition
            });
        if (!string.IsNullOrWhiteSpace(amenity)) 
            FullFacilityFilterItems.Amenities.Add(new AmenityViewmodel()
            {
                Name = amenity
            });
        if (!string.IsNullOrWhiteSpace(treatment))
            FullFacilityFilterItems.Treatments.Add(new TreatmentViewmodel
                {
                    Name = treatment.ToLowerInvariant()
                });
        if (!string.IsNullOrWhiteSpace(insurance))
            FullFacilityFilterItems.Insurances.Add(new InsuranceViewModel
                {
                    Name = insurance
                });

        if (!string.IsNullOrWhiteSpace(loc)) 
            FullFacilityFilterItems.Locs.Add(new LocViewmodel
                {
                    Name = loc
                });
        if (!string.IsNullOrWhiteSpace(wwt)) 
            FullFacilityFilterItems.Wwts.Add(new WwtViewModel
            {
                Name = wwt
            }) ;
        if (!string.IsNullOrWhiteSpace(swt)) 
            FullFacilityFilterItems.Swts.Add(new SwtViewModel
            {
                Name = swt
            }) ;
        #endregion

        await LoadMore();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRefState = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("infiniteScroll.initialize",
                "scrollTrigger",
                objRefState);
        }
    }

    [JSInvokable]
    public async Task LoadMore()
    {
        if (IsLoading || !HasMore)
            return;

        IsLoading = true;
        StateHasChanged();

        var newItems = await FacilityService.GetFacilityCardsAsync(page, pageSize, 
        mapper.Map<FullFacilityFilterItemsDto>(FullFacilityFilterItems));

        if (newItems.Item1.Count < pageSize)
            HasMore = false;

        FacilityCards.AddRange(mapper.Map<List<FacilityCardViewmodel>>(newItems.Item1));
        TotalCount = newItems.totalCount;
        if (page == 1)
            ResultsFiltered = PickedCount > 0 || FullFacilityFilterItems.Swts.Count > 0
                || !string.IsNullOrWhiteSpace(FullFacilityFilterItems.SearchText);
        page++;

        IsLoading = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        objRefState?.Dispose();
    }


    //----------------------------------------------------------

