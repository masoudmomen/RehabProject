@page "/claim-your-profile"
@* @rendermode InteractiveServer *@
@inject IJSRuntime jSRuntime
@using Rehab.EndPoint.Web.ViewModels
@using Microsoft.AspNetCore.Components.Web
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.Application.Email
@using Rehab.Application.Common
@using static Rehab.Application.Common.EmailTemplates
@inject IEmailService EmailService
@inject IConfiguration Config


@using Rehab.Application.Seo
@inject ISeoService SeoService


<HeadContent>
    <meta name="keywords" content="@Keywords" />
    <meta name="description" content="@Description" />
</HeadContent>


<Seo Title="Claim or Submit Your Facility - Rehab Navigator"
     Description="Claim your RehabNavigator provider profile or submit facility information for directory review. Request listing updates, submit a new facility, or manage your treatment center profile."
     CanonicalUrl="https://RehabNavigator.com/claim-your-profile"
     FaviconUrl="favicon.png" />

<div class="container py-3">
    <HeroSectionComponent SectionTitle="Claim or Submit Your Facility"
                          SectionSubtitle="Whether your facility is already listed on RehabNavigator or not yet included in our directory, you may submit basic facility information for our team to review." />
</div>

<main class="claim-page-wrap">

    <section class="container my-5">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-md-5 text-center">
                <h2 class="h3">Submit Facility Information</h2>
                <p class="text-muted">Use this page to request a new listing, claim an existing profile, or submit basic facility information for directory review.</p>
                <button type="button" class="btn btn-primary-gradient w-25 w-md-auto"
                        data-bs-toggle="modal"
                        data-bs-target="#ClaimModal">
                    Submit Facility Information
                </button>
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section class="container my-5" aria-labelledby="how-title">
        <div class="text-center mb-4">
            <h2 id="how-title" class="h3">How it works</h2>
            <p class="text-muted">Our team reviews submitted information to help maintain organized directory listings.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-4 step-card-body">
                        <div class="step-number">1</div>
                        <h3 class="h5">Submit Facility Information</h3>
                        <p class="text-muted small mb-0">Provide basic details about your facility and the listing request you would like our team to review.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-4 step-card-body">
                        <div class="step-number">2</div>
                        <h3 class="h5">Directory Review</h3>
                        <p class="text-muted small mb-0">RehabNavigator may review submitted information for accuracy, relevance, and directory use.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-4 step-card-body">
                        <div class="step-number">3</div>
                        <h3 class="h5">Follow-Up if Needed</h3>
                        <p class="text-muted small mb-0">Our team may contact you if additional information is needed regarding your request.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Information You May Submit -->
    <section class="container my-5" aria-labelledby="info-title">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 id="info-title" class="h3">Information You May Submit</h2>
                    <p class="text-muted">Claim requests and listing submissions should focus on basic facility information.</p>
                </div>
                <div class="row g-3">
                    <div class="col-md-6"><div class="info-item"><span class="check">✓</span> Facility name</div></div>
                    <div class="col-md-6"><div class="info-item"><span class="check">✓</span> Facility address</div></div>
                    <div class="col-md-6"><div class="info-item"><span class="check">✓</span> Facility website</div></div>
                    <div class="col-md-6"><div class="info-item"><span class="check">✓</span> Facility phone number</div></div>
                    <div class="col-md-6"><div class="info-item"><span class="check">✓</span> Facility email address</div></div>
                    <div class="col-md-6"><div class="info-item"><span class="check">✓</span> General facility information</div></div>
                    <div class="col-md-6"><div class="info-item"><span class="check">✓</span> Primary levels of care</div></div>
                    <div class="col-md-6"><div class="info-item"><span class="check">✓</span> Contact information for follow-up</div></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Interested in More Visibility -->
    <section class="container my-5" aria-labelledby="visibility-title">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-md-5 text-center">
                <h2 id="visibility-title" class="h3">Interested in more visibility?</h2>
                <p class="text-muted">
                    Submitting facility information helps our team review basic listing details. If your facility wants additional visibility,
                    featured placement, or expanded provider options, you can also explore advertising and package information.
                </p>
                <div class="text-links">
                    <a href="/packages" target="_blank">Advertise With Us</a>
@*                     <a href="/packages" target="_blank">View Plans &amp; Pricing</a> *@
                </div>
            </div>
        </div>
    </section>

    <!-- Note -->
    <section class="container my-5" aria-label="Listing request note">
        <div class="alert alert-light border small text-muted mb-0">
            <strong class="text-dark">Important:</strong> Submission of information does not guarantee inclusion in the directory or changes to an existing listing.
            RehabNavigator may review submitted information and determine whether updates are appropriate for directory purposes.
        </div>
    </section>

</main>

<!-- Modal -->
<ClaimFormModalComponent />

@code {
    private string? Keywords;
    private string? Description;
    private void LoadMeta()
    {
        var Meta = SeoService.GetMeta("ClaimYourProfile");

        if (Meta != null)
        {
            if (Meta.Keywords != null)
                Keywords = string.Join(",", Meta.Keywords);

            Description = Meta.Description;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LoadMeta();
    }
}
