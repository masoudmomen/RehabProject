@page "/blog/archive"
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.EndPoint.Web.ViewModels
@using Rehab.Application.Blog
@using Rehab.Application.Dtos
@using AutoMapper
@inject IMapper mapper
@inject IBlogPostService BlogPostService
@inject NavigationManager Navigation
@rendermode InteractiveServer
<PageTitle>@_metaTitle</PageTitle>

<HeadContent>
    <meta name="description" content="@_metaDescription" />
    <link rel="canonical" href="@_canonicalUrl" />

    @if (Articles is not null && Articles.HasPerviousPage)
    {
        <link rel="prev" href="@BuildPageUrl(CurrentPage - 1)" />
    }
    @if (Articles is not null && Articles.HasNextPage)
    {
        <link rel="next" href="@BuildPageUrl(CurrentPage + 1)" />
    }

    <meta property="og:title" content="@_metaTitle" />
    <meta property="og:description" content="@_metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@_canonicalUrl" />

    @if (!string.IsNullOrWhiteSpace(SearchTerm) || CurrentPage > 1)
    {
        <meta name="robots" content="noindex, follow" />
    }
</HeadContent>
<div class="container mt-5">
<BlogSearch InitialValue="@SearchTerm" OnSearch="HandleSearch" />
</div>

<BlogFilterBar />
<div class="container mb-5">
  
    <div class="mb-3 page-head">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/blog">Blog</a></li>
                <li class="breadcrumb-item active" aria-current="page">All Articles</li>
            </ol>
        </nav>
        <h1>All Articles</h1>
        <p>Browse guides, stories, and insights on substanc use, mental health, treatment, and recovery.</p>
    </div>
    <hr />
    <div class="archive-grid @(ViewMode == "list" ? "view-list" : "")">
        @if (_isLoading)
        {
            @for (int i = 0; i < PageSize; i++)
            {
                <div class="card-skeleton"></div>
            }
        }
        else if (Articles is not null && Articles.Data.Any())
        {
            @foreach (var item in Articles.Data)
            {
                <BlogPostCard Article="item" HighlightTerm="@SearchTerm" />
            }
        }
        else
        {
            <div class="empty-state">
                <p>No articles were found with this filter.</p>
            </div>
        }
    </div>

    @if (!_isLoading && Articles is not null && Articles.Pager.TotalPages > 1)
    {
        var pages = Articles.Pager.Pages.ToList();
        var totalPages = Articles.Pager.TotalPages;

        <nav class="pager" aria-label="Article archive pagination">
            <ul class="pager-list">
                <li>
                    @if (Articles.HasPerviousPage)
                    {
                        <a href="@BuildPageUrl(CurrentPage - 1)" class="pager-btn pager-nav" rel="prev" aria-label="Previous page">
                            <span aria-hidden="true">&larr;</span> Prev
                        </a>
                    }
                    else
                    {
                        <span class="pager-btn pager-nav disabled" aria-disabled="true">
                            <span aria-hidden="true">&larr;</span> Prev
                        </span>
                    }
                </li>

                @if (pages.First() > 1)
                {
                    <li><a href="@BuildPageUrl(1)" class="pager-btn">1</a></li>
                    if (pages.First() > 2)
                    {
                        <li><span class="pager-ellipsis" aria-hidden="true">&hellip;</span></li>
                    }
                }

                @foreach (var p in pages)
                {
                    <li>
                        @if (p == CurrentPage)
                        {
                            <span class="pager-btn active" aria-current="page">@p</span>
                        }
                        else
                        {
                            <a href="@BuildPageUrl(p)" class="pager-btn">@p</a>
                        }
                    </li>
                }

                @if (pages.Last() < totalPages)
                {
                    if (pages.Last() < totalPages - 1)
                    {
                        <li><span class="pager-ellipsis" aria-hidden="true">&hellip;</span></li>
                    }
                    <li><a href="@BuildPageUrl(totalPages)" class="pager-btn">@totalPages</a></li>
                }

                <li>
                    @if (Articles.HasNextPage)
                    {
                        <a href="@BuildPageUrl(CurrentPage + 1)" class="pager-btn pager-nav" rel="next" aria-label="Next page">
                            Next <span aria-hidden="true">&rarr;</span>
                        </a>
                    }
                    else
                    {
                        <span class="pager-btn pager-nav disabled" aria-disabled="true">
                            Next <span aria-hidden="true">&rarr;</span>
                        </span>
                    }
                </li>
            </ul>
        </nav>
    }

</div>

@code {
    private const string BaseUrl = "/blog/archive";

    [SupplyParameterFromQuery(Name = "page")]
    public int CurrentPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "view")]
    public string ViewMode { get; set; } = "grid";

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchTerm { get; set; }

    public PaginatedItemDto<BlogPostCardViewModel>? Articles { get; set; }

    private int PageSize = 12;
    private bool _isLoading = true;
    private string _metaTitle = "Article archive";
    private string _metaDescription = "Every guide, story and reflection we've published — searchable and filterable, so you can find exactly what your recovery needs right now.";
    private string _canonicalUrl = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var requestedPage = CurrentPage < 1 ? 1 : CurrentPage;
        await LoadPageAsync(requestedPage);
    }

    private async Task LoadPageAsync(int page)
    {
        _isLoading = true;

        // var filter = string.IsNullOrWhiteSpace(Topic)
        //     ? null
        //     : new BlogPostFilter { TopicSlug = Topic };
        var filter = string.IsNullOrWhiteSpace(SearchTerm)
            ? null
            : new BlogPostFilter { 
                SearchTerm = SearchTerm ,
                ExcludeFeatured = false
                };   
        var result = await BlogPostService.GetPostCardsAsync(page, PageSize, filter);
        var mapped = mapper.Map<IEnumerable<BlogPostCardViewModel>>(result.Data);
        Articles = new PaginatedItemDto<BlogPostCardViewModel>(result.PageIndex, result.PageSize, result.Count, mapped);
//Outside URL
        if (Articles.Pager.TotalPages > 0 && page > Articles.Pager.TotalPages)
        {
            _isLoading = false;
            Navigation.NavigateTo(BuildPageUrl(Articles.Pager.TotalPages), forceLoad: false);
            return;
        }

        CurrentPage = Articles.PageIndex;
        _isLoading = false;

        BuildSeoMetadata();
    }

    private void BuildSeoMetadata()
    {
        var searchSuffix = string.IsNullOrWhiteSpace(SearchTerm)
        ? string.Empty
        : $" — Search results for \"{SearchTerm}\"";

        _metaTitle = CurrentPage <= 1
            ? $"Article archive{searchSuffix}"
            : $"Article archive{searchSuffix} — Page {CurrentPage}";

        _metaDescription = CurrentPage <= 1
            ? "Every guide, story and reflection we've published — searchable and filterable, so you can find exactly what your recovery needs right now."
            : $"Page {CurrentPage} of our article archive{searchSuffix}.";

        var origin = Navigation.BaseUri.TrimEnd('/');
        _canonicalUrl = $"{origin}{BuildPageUrl(CurrentPage)}";
    }

    private string BuildPageUrl(int page)
    {
        var parts = new List<string>();

        if (page > 1)
        {
            parts.Add($"page={page}");
        }

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            parts.Add($"search={Uri.EscapeDataString(SearchTerm)}");
        }

        if (!string.IsNullOrWhiteSpace(ViewMode) && ViewMode != "grid")
        {
            parts.Add($"view={Uri.EscapeDataString(ViewMode)}");
        }

        return parts.Count == 0
            ? BaseUrl
            : $"{BaseUrl}?{string.Join("&", parts)}";
    }
    private void HandleSearch(string searchTerm)
    {
        Navigation.NavigateTo(
              $"/blog/archive?search={Uri.EscapeDataString(searchTerm)}");
    }
}
