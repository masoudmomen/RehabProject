@page "/Privacy-Policy"
@* @rendermode InteractiveServer *@
@inject IJSRuntime jSRuntime
@using Microsoft.AspNetCore.Components.Web
@using Rehab.EndPoint.Web.Components.Common

@using Rehab.Application.Seo
@inject ISeoService SeoService


<HeadContent>
    <meta name="keywords" content="@Keywords" />
    <meta name="description" content="@Description" />
</HeadContent>

<Seo Title="Privacy Policy - Rehab Navigator"
     Description="Learn about Rehab's commitment to protecting your privacy and the measures we take to ensure your data is safe."
     CanonicalUrl="https://www.rehabnavigator.com/privacy-policy"
     FaviconUrl="favicon.png" />
 
<!-- Page wrapper -->
<div class="container">
    <HeroSectionComponent SectionTitle="Privacy Policy"
                          SectionSubtitle="This Privacy Policy explains how RehabNavigator may collect, use, share, protect, and manage information when you use our website, browse provider profiles, submit website forms, or interact with our services.">
    </HeroSectionComponent>
    <div class="bg-white mt-3 rounded-2 p-3 border-1 border-light shadow">
        <p>
            <strong>Important: </strong>RehabNavigator is an online directory and information platform. We help users explore provider information and related resources.
            <br/>
            We do not provide medical care, make treatment recommendations, or act as a treatment provider, insurance company, referral service, or admissions service.
        </p>
    </div>
</div>
<PolicySectionComponent
    Title="Privacy Policy" 
    Sections="@_sections"
    CtaTitle="Need help finding treatment?"
                        CtaDescription="Browse treatment center profiles, review levels of care, compare treatment approaches, and explore facility information." />


@code {
    private string? Keywords;
    private string? Description;
    private void LoadMeta()
    {
        var Meta = SeoService.GetMeta("PrivacyPolicy");

        if (Meta != null)
        {
            if (Meta.Keywords != null)
                Keywords = string.Join(",", Meta.Keywords);

            Description = Meta.Description;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LoadMeta();
    }

    private readonly List<PolicySectionComponent.PolicySectionItem> _sections = new()
{
    new()
    {
        Id = "Overview",
        NavLabel = "Overview",
        Title = "Overview",
        Body = "<p>RehabNavigator provides directory information, provider profiles, search tools, resource pages, and provider visibility options related to drug and alcohol rehab centers, mental health providers, behavioral health facilities, and recovery resources.</p>" +
               "<p>This Privacy Policy applies to website visitors, individuals and families using the directory, treatment providers, facility representatives, advertisers, and anyone who submits information through RehabNavigator.</p>"
    },
    new()
    {
        Id = "directory",
        NavLabel = "Directory Information",
        Title = "About Directory Information",
        Body = "<p>RehabNavigator may organize provider information supplied by treatment providers, facility representatives, advertisers, publicly available sources, or other sources reasonably believed to be relevant at the time information is displayed.</p>" +
               "<p>Provider information may change over time. Users should confirm important details directly with the provider before making decisions.</p>"
    },
    new()
    {
        Id = "collect",
        NavLabel = "Information We May Collect",
        Title = "Information We May Collect",
        Body = "<h3>Information You Submit</h3>" +
               "<ul>" +
               "<li>Name, email address, message content, and general inquiry details.</li>" +
               "<li>Facility or provider-related information submitted through forms.</li>" +
               "<li>Listing update requests, claim profile requests, new listing requests, advertising inquiries, or provider visibility requests.</li>" +
               "</ul>" +
               "<h3>Website and Usage Information</h3>" +
               "<ul>" +
               "<li>Pages visited, search activity, filters used, and provider profiles viewed.</li>" +
               "<li>Browser type, device type, operating system, IP address, approximate location information, and similar technical data.</li>" +
               "<li>Analytics, cookie, pixel, session, or similar technical information if those tools are used.</li>" +
               "</ul>" +
               "<h3>Provider and Facility Information</h3>" +
               "<ul>" +
               "<li>Facility name, address, website link, general contact details, services, levels of care, treatment approaches, insurance information, amenities, accreditations, photos, and facility highlights.</li>" +
               "<li>Business contact information for provider representatives or listing contacts.</li>" +
               "</ul>"
    },
    new()
    {
        Id = "use",
        NavLabel = "How Information May Be Used",
        Title = "How Information May Be Used",
        Body = "<p>RehabNavigator may use information for website operation, user support, directory management, provider communications, security, analytics, and platform improvement.</p>" +
               "<ul>" +
               "<li>Respond to inquiries, contact requests, or support messages.</li>" +
               "<li>Operate, maintain, secure, and improve the website.</li>" +
               "<li>Support search tools, provider profiles, listing pages, and directory features.</li>" +
               "<li>Process provider listing, profile claim, update, advertising, or pricing inquiries.</li>" +
               "<li>Analyze website performance, traffic, usability, and feature engagement.</li>" +
               "<li>Detect, prevent, and respond to fraud, abuse, technical issues, or security risks.</li>" +
               "<li>Comply with legal obligations, enforce policies, and protect rights.</li>" +
               "</ul>" +
               "<div class=\"soft-box\">RehabNavigator does not sell personal information to third-party data brokers.</div>"
    },
    new()
    {
        Id = "share",
        NavLabel = "How Information May Be Shared",
        Title = "How Information May Be Shared",
        Body = "<p>RehabNavigator may share information only as reasonably necessary for website operation, vendor support, analytics, security, legal compliance, or business purposes described in this Privacy Policy.</p>" +
               "<h3>Service Providers and Vendors</h3>" +
               "<p>Information may be shared with hosting providers, form tools, email services, analytics providers, security vendors, support tools, CRM systems, advertising measurement tools, or other service providers.</p>" +
               "<h3>Advertising and Analytics Partners</h3>" +
