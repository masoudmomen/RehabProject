@page "/term-of-use"
@using Rehab.Application.Seo
@inject ISeoService SeoService

@using Rehab.EndPoint.Web.Components.Common
<HeadContent>
    <meta name="keywords" content="@Keywords" />
    <meta name="description" content="@Description" />
</HeadContent>
<Seo Title="Terms of Use - Rehab Navigator"
     Description="Learn about Rehab's commitment to providing accurate information and the limitations of our directory and resources."
     CanonicalUrl="https://www.rehabnavigator.com/term-of-use"
     FaviconUrl="favicon.png" />
<div class="container">
    <HeroSectionComponent SectionTitle="Terms of Use"
                          SectionSubtitle="These Terms of Use explain the rules and conditions for accessing and using RehabNavigator, including our directory, provider profiles, search tools, website features, and related services.">
    </HeroSectionComponent>
    <div class="bg-white mt-3 rounded-2 p-3 border-1 border-light shadow">
        <p>
            <strong>Important: </strong> RehabNavigator is an online directory and information platform. We help users explore provider information and related resources.
            <br/>
            We do not provide medical care, make treatment recommendations, or act as a treatment provider, insurance company, referral service, admissions service. By using RehabNavigator, you agree to use the website only for lawful, informational, and directory-related purposes.
        </p>
    </div>
</div>
<PolicySectionComponent Title="Disclaimer" Sections="@_sections" />
@code {
    private string? Keywords;
    private string? Description;
    private void LoadMeta()
    {
        var Meta = SeoService.GetMeta("TermOfUse");

        if (Meta != null)
        {
            if (Meta.Keywords != null)
                Keywords = string.Join(",", Meta.Keywords);

            Description = Meta.Description;
        }

    }
