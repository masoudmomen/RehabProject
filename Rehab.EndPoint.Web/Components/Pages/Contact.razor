@page "/contact-us"
@inject IJSRuntime jSRuntime
@using Microsoft.AspNetCore.Components.Web
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.EndPoint.Web.ViewModels
@using Rehab.Application.Seo
@using Rehab.Application.Email
@using Rehab.Application.Common
@using static Rehab.Application.Common.EmailTemplates

@inject IConfiguration Config
@inject IEmailService EmailService
@inject ISeoService SeoService


<HeadContent>
    <meta name="keywords" content="@Keywords" />
    <meta name="description" content="@Description" />
</HeadContent>

<Seo Title="Contact Us - Rehab Navigator"
     Description="Learn about Rehab's mission, values, and the team behind our innovative solutions."
     CanonicalUrl="https://Rehabnavigator.com/about-us"
     FaviconUrl="favicon.png" />
<div class="container py-3">
    <HeroSectionComponent SectionTitle="Contact Us"
                          SectionSubtitle="Contact the RehabNavigator team with questions about our website, provider listings, profile updates, advertising, or technical issues. We'll do our best to respond as soon as possible." />
</div>
<main class="contact-page-wrap">
    <EditForm Model="FormModel" id="general-contact-form" OnValidSubmit="HandleSubmit" method="post" Enhance FormName="general-contact-form">
        <DataAnnotationsValidator />
    
        <div class="container my-5">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-body p-4 p-md-5">
                            <div class="row g-3">

                                <!-- Inquiry Type -->
                                <div class="col-12">
                                    <label for="contact-inquiry-type" class="form-label">What can we help you with? *</label>
                                    <InputSelect id="contact-inquiry-type" class="form-select" @bind-Value="FormModel.InquiryType">
                                        <option value="">Select an option</option>
                                        <optgroup label="General Inquiries">
                                            <option value="General Question">General Question</option>
                                            <option value="Website Feedback">Website Feedback</option>
                                            <option value="Technical Issue">Technical Issue</option>
                                            <option value="Report Incorrect Information">Report Incorrect Information</option>
                                        </optgroup>
                                        <optgroup label="Listings &amp; Profiles">
                                            <option value="Claim or Submit Your Facility">Claim or Submit Your Facility</option>
                                            <option value="Request a Listing Update">Request a Listing Update</option>
                                            <option value="General Listing Question">General Listing Question</option>
                                        </optgroup>
                                        <optgroup label="Provider Services">
                                            <option value="Advertising Inquiry">Advertising Inquiry</option>
                                            <option value="Plans &amp; Pricing Question">Plans &amp; Pricing Question</option>
                                        </optgroup>
                                        <optgroup label="Other">
                                            <option value="Other">Other</option>
                                        </optgroup>
                                    </InputSelect>
                                    <ValidationMessage For="() => FormModel.InquiryType" class="text-danger small" />
                                </div>

                                <!-- Name -->
                                <div class="col-md-6">
                                    <label for="contact-name" class="form-label">Name *</label>
                                    <InputText id="contact-name" class="form-control" @bind-Value="FormModel.Name" placeholder="Your name" />
                                    <ValidationMessage For="() => FormModel.Name" class="text-danger small" />
                                </div>

                                <!-- Email -->
                                <div class="col-md-6">
                                    <label for="contact-email" class="form-label">Email Address *</label>
                                    <InputText id="contact-email" class="form-control" type="email" @bind-Value="FormModel.Email" placeholder="Email address" />
                                    <ValidationMessage For="() => FormModel.Email" class="text-danger small" />
                                </div>

                                <!-- Phone -->
                                <div class="col-md-6">
                                    <label for="contact-phone" class="form-label">Phone Number (Optional)</label>
                                    <InputText id="contact-phone" class="form-control" type="tel" @bind-Value="FormModel.Phone" placeholder="Phone number" />
                                </div>

                                <!-- Facility Name -->
                                <div class="col-md-6">
                                    <label for="contact-facility" class="form-label">Facility Name (Optional)</label>
                                    <InputText id="contact-facility" class="form-control" @bind-Value="FormModel.FacilityName" placeholder="Facility name" />
                                    <div class="form-text">Only if your inquiry relates to a treatment provider or facility.</div>
                                </div>

                                <!-- Message -->
                                <div class="col-12">
                                    <label for="contact-message" class="form-label">Message *</label>
                                    <InputTextArea id="contact-message" class="form-control" rows="5" @bind-Value="FormModel.Message" placeholder="Briefly tell us how we can help." />
                                    <ValidationMessage For="() => FormModel.Message" class="text-danger small" />
                                </div>
                                <div class="container">
                                    <div class="col-12">
                                        @if (SuccessMessage is not null)
                                        {
                                            <div class="alert alert-success">@SuccessMessage</div>
                                        }
                                        @if (ErrorMessage is not null)
                                        {
                                            <div class="alert alert-danger">@ErrorMessage</div>
                                        }
                                    </div>
                                </div>
                                <!-- Submit -->
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary-gradient w-100 w-md-auto">Send Message</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </EditForm>
</main>
<script>
    (function () {
        console.log("AAAAAAAAAAAAAA");
        const form = document.getElementById('general-contact-form');
        const btn = document.getElementById('general-contact-submit-btn');
        const text = document.getElementById('general-contact-submit-text');

        if (form && !form.dataset.sendingHandlerAttached) {
            form.dataset.sendingHandlerAttached = 'true';
            form.addEventListener('submit', function () {
                if (btn) btn.disabled = true;
                if (text) text.textContent = 'Sending...';
            });
        }
    })();
</script>
@code {
    private string? SuccessMessage;
    private string? ErrorMessage;
    [SupplyParameterFromForm]
    public ContactFormModel FormModel { get; set; } = new();

    private string? Keywords;
    private string? Description;

    private void LoadMeta()
    {
        var Meta = SeoService.GetMeta("ContactUs");

        if (Meta != null)
        {
            if (Meta.Keywords != null)
                Keywords = string.Join(",", Meta.Keywords);

            Description = Meta.Description;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LoadMeta();
    }
    private async Task HandleSubmit()
    {
        try
        {
            var adminEmail = Config["Email:ToAdmin"];
            var dto = new ContactFormDto(
            FormModel.InquiryType,
            FormModel.Name,
            FormModel.Email,
            FormModel.Phone,
            FormModel.FacilityName,
            FormModel.Message
            );

            await EmailService.SendEmailAsync(
                to: [adminEmail!, "maghsoudloo.h.a@gmail.com"],
                subject: "Contact Us | Advertise With Us",
                body: BuildGeneralContactEmailBody(dto)
                );
            await EmailService.SendEmailAsync(
                to: [FormModel.Email],
                subject: "We received your message – RehabNavigator",
                body: BuildAdvertiseContactConfirmationBody(FormModel.Name)
                );

            SuccessMessage = "Your message has been sent. We'll be in touch soon!";
            ErrorMessage = null;
            FormModel = new(); // reset
        }
        catch (Exception ex)
        {
            ErrorMessage = "Something went wrong. Please try again.";
            SuccessMessage = null;
        }
    }
}
