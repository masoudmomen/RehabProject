@page "/States/{statename}"
@rendermode InteractiveServer
@using Rehab.EndPoint.Web.ViewModels
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.EndPoint.Web.Components.Facility
@using Rehab.EndPoint.Web.Data
@using Rehab.Application.Facilities
@using Rehab.EndPoint.AdminPanel.CommonService

@inject IFacilityService FacilityService
@inject AutoMapper.IMapper mapper
@inject IJSRuntime JS
@inject IConfiguration Config
@inject InternalLocationService InternalLocationService

@using Rehab.Application.Seo
@inject ISeoService SeoService


<HeadContent>
    <meta name="keywords" content="@Keywords" />
    <meta name="description" content="@Description" />
</HeadContent>

<div class="container  rounded-2 py-2">
    <BreadCrumbComponent Items="@breadCrumbItems"></BreadCrumbComponent>
</div>
<div class="container">
    <section class="state-hero">
        <div class="state-hero-media">
            <img src="@(serverUrl + GetStateImagePath())" alt="" />
        </div>
        <div class="state-hero-content">
            <h1 class="state-hero-title">Drug &amp; Alcohol Recovery Centers and Rehabs in @statename</h1>
            <p class="state-hero-subtitle">@GetStateDescription()</p>
        </div>
    </section>
</div>
<div class="container mt-3">
    <input type="checkbox" id="sidebarToggle" hidden />
    <div class="sidebar-overlay"></div>
    <div class="row layout-wrapper">
        <div class="content-a">
            <TreatmentCenterFilter @bind-Filters="FullFacilityFilterItems"
                                   Fields="Fields"
                                   States="StateOptions"
                                   Cities="Cities"
                                   OnStatesChanged="HandleCities"
                                   OnSearch="ApplyFilter" />

            <div class="container mt-3 mb-5 featured-centers ">
                <div class="d-flex align-items-center py-2" style="border-bottom: solid 2px #93e2f1;">
                    <h5 class=" mb-0">Our recovery centers in @statename</h5>
                </div>

                <div class="row g-4">
                    @foreach (var facility in FacilityCards)
                    {
                        <div class="col-md-4 mb-3">
                            <FacilityItem ShowTags="false" FacilityCard="facility" CustomClass="small-card" />
                        </div>
                    }
                </div>

                @if (IsLoading)
                {
                    <p>Loading...</p>
                }

                <div id="scrollTrigger"></div>
            </div>
        </div>
        <div class="content-b">
            <SidebarComponent State="@statename" />
        </div>
    </div>
</div>


@code {
    [Parameter]
    public string? statename { get; set; }   

    [Parameter]
    public string? searchText { get; set; }

    private List<BreadCrumbComponent.BreadCrumbItem> breadCrumbItems = new();
    public FacilityFilterItems FilteredItems { get; set; } = new();
    protected override void OnParametersSet()
    {
        breadCrumbItems = new()
        {
            new() {Text="Home" , Href="/"},
            new() {Text="Treatment Centers" , Href="/treatment-centers"},
            new() {Text= statename?? "Unknown" ,IsActive=true}

        };

    }
    private string GetStateImagePath()
    {
        if (string.IsNullOrWhiteSpace(statename))
        {
            return "img/statesimages/no-image.jpg";
        }

        var state = USStates.All.FirstOrDefault(s =>
            s.Name.Equals(statename, StringComparison.OrdinalIgnoreCase) ||
            s.UrlSlug.Equals(statename, StringComparison.OrdinalIgnoreCase));

        var imageFileName = state?.Image;

        if (string.IsNullOrWhiteSpace(imageFileName))
        {
            return "img/statesimages/no-image.jpg";
        }

        return $"img/statesimages/{imageFileName}";
    }
    private string GetStateDescription()
    {
        var stateLabel = string.IsNullOrWhiteSpace(statename) ? "this state" : statename;
        return $"Explore accredited recovery centers, resources, and support options across {stateLabel}.";
    }

    //infinite scroll
    //----------------------------------------------------------

    private List<FacilityCardViewmodel> FacilityCards = new();
    private int page = 1;
    private int pageSize = 12;
    private bool IsLoading = false;
    private bool HasMore = true;

    private DotNetObjectReference<States>? objRefState;

    [Parameter]
    public FullFacilityFilterItemsViewmodel FullFacilityFilterItems { get; set; } = new();


    private string? Keywords;
    private string? Description;
    private void LoadMeta()
    {
        var Meta = SeoService.GetMeta("Facilities");

        if (Meta != null)
        {
            if (Meta.Keywords != null)
                Keywords = string.Join(",", Meta.Keywords);

            Description = Meta.Description;
        }
    }
    private string? serverUrl;
    private FacilityFieldsViewmodel Fields { get; set; } = new();
    private List<string>? StateOptions;
    private List<string>? Cities = new();

    protected override async Task OnInitializedAsync()
    {
        serverUrl = Config["AppSettings:AdminServerUrl"];
        LoadMeta();

        StateOptions = await InternalLocationService.GetStateWithoutHttpAsync(serverUrl!)!;
        Fields = mapper.Map<FacilityFieldsViewmodel>(FacilityService.GetListFacilityFields());

        if (statename.Contains("-")) statename = statename.Replace("-", " ");
        // use the list's spelling so the state's Location checkbox shows as ticked
        statename = StateOptions?.FirstOrDefault(s => s.Equals(statename, StringComparison.OrdinalIgnoreCase)) ?? statename;
        FullFacilityFilterItems.States.Add(statename);
        await HandleCities(FullFacilityFilterItems.States);

        //await LoadMore();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRefState = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("infiniteScroll.initialize",
                "scrollTrigger",
                objRefState);
        }
    }

    [JSInvokable]
    public async Task LoadMore()
    {
        if (IsLoading || !HasMore)
            return;

        IsLoading = true;
        StateHasChanged();

        var newItems = await FacilityService.GetFacilityCardsAsync(page, pageSize, 
        mapper.Map<FullFacilityFilterItemsDto>(FullFacilityFilterItems));

        if (newItems.Item1.Count < pageSize)
            HasMore = false;

        FacilityCards.AddRange(mapper.Map<List<FacilityCardViewmodel>>(newItems.Item1));
        page++;

        IsLoading = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        objRefState?.Dispose();
    }


    //----------------------------------------------------------


    async Task ApplyFilter(FullFacilityFilterItemsViewmodel FullFacilityFilterItemsArg)
    {
        this.FullFacilityFilterItems = FullFacilityFilterItemsArg;
        FacilityCards = new();
        page = 1;
        IsLoading = false;
        HasMore = true;
        await LoadMore();
    }
    private async Task HandleCities(List<string> states)
    {
        Cities = await InternalLocationService.GetCitiesByStatesAsync(serverUrl!, states);
    }

    async Task ApplySearch(string searchTextFromComponent)
    {
        searchText = FullFacilityFilterItems.SearchText = searchTextFromComponent;
        await ApplyFilter(FullFacilityFilterItems);
    }
}
