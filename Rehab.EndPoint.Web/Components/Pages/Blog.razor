@page "/blog"
@using Rehab.EndPoint.Web.ViewModels
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.Application.Blog
@using AutoMapper
@inject IMapper mapper
@inject IBlogTopicService BlogTopicService
@inject NavigationManager Navigation
@rendermode InteractiveServer
<div class="container mt-5">
    <BlogSearch InitialValue="@SearchTerm" OnSearch="HandleSearch" />
</div>
<BlogFilterBar />
<BlogFeaturedArticle />
<BlogCardList />
<BlogSubscribe />
<BlogBrowseByTopic Topics="Topics" />

@code {
    public List<TopicViewModel> Topics { get; set; } = new();
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchTerm { get; set; }
    protected override void OnInitialized()
    {
        var result = BlogTopicService.GetList();
        if (result != null)
        {
            Topics = mapper.Map<List<TopicViewModel>>(result);
        }
    }
    private void HandleSearch(string searchTerm)
    {
        Navigation.NavigateTo(
              $"/blog/archive?search={Uri.EscapeDataString(searchTerm)}");
    }
}
