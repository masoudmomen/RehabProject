@page "/packages"
@rendermode InteractiveServer
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.EndPoint.Web.ViewModels
@using Rehab.Domain.Packages.Enums
@using Rehab.Application.Packages
@using Rehab.Application.Seo
@inject ISeoService SeoService
@inject IPackagePricingService PackagePricingService

<HeadContent>
    <meta name="keywords" content="@Keywords" />
    <meta name="description" content="@Description" />
</HeadContent>
<div class="container">
    <HeroSectionComponent SectionTitle="Advertise With Us"
                          SectionSubtitle="RehabNavigator helps treatment providers increase visibility in a directory where individuals, families, and loved ones compare rehab centers, detox services, addiction treatment programs, mental health providers, and behavioral health facilities" />
</div>
<div class="container text-center">
    <h2 class="mt-3">Plans & Pricing </h2>
    <p>    Choose the visibility level that fits your facility.</p>
</div>

<section class="billing-toggle-wrap mt-3" aria-label="Billing options">
  
    <br/>
    <div class="billing-toggle">
        <input type="radio" id="billing-annual" name="billing" value="annual"
               checked="@(selectedBillingtype == BillingType.Annually)"
               @onchange="() => selectedBillingtype = BillingType.Annually" />
        <label for="billing-annual">Annual Plan</label>

        <input type="radio" id="billing-monthly" name="billing" value="monthly"
               checked="@(selectedBillingtype == BillingType.Monthly)"
               @onchange="() => selectedBillingtype = BillingType.Monthly" />
        <label for="billing-monthly">Monthly Plan</label>
    </div>

</section>
<div class="text-center">
  

    @if (selectedBillingtype == BillingType.Annually)
    {
        <p>
            Reduced monthly rate with a 12-month commitment.Payments are made monthly.
        </p>
    }
    else if (selectedBillingtype == BillingType.Monthly)
    {
        <p>
            Flexible month-to-month billing. Billing monthly.
        </p>
    }

</div>
<section class="packages mt-5">
    <!-- Pricing Cards -->
    <div class="container pb-2 px-4">

        <div class="row g-4">

            <!-- Free -->
            <div class="col-12 col-md-3">
                <div class="pkg-card p-4">
                    <p class="pkg-name mb-1"> Claim Profile For Free</p>

                    <hr class="my-2" style="border-color:#e8e7e0;opacity:1;">
                    <p class="price-val mb-0">$0</p>
                    <hr class="my-2" style="border-color:#e8e7e0;opacity:1;">

                    <ul class="feature-list mb-3">
                        <li><span class="check-dot check-gray"><i class="fa-solid fa-check check-icon" aria-hidden="true"></i></span>Essential Listing</li>
                        <li><span class="check-dot check-gray"><i class="fa-solid fa-check check-icon" aria-hidden="true"></i></span>Minimal Visibility</li>

                    </ul>

                    <div class="mt-auto">
                        <button type="button" class="btn-pkg"
                                data-bs-toggle="modal"
                                data-bs-target="#ClaimModal">
                            Claim Profile
                        </button>

                    </div>
                </div>
            </div>
            <!-- Essential -->
            <div class="col-12 col-md-3">
                <div class="pkg-card p-4">
                    <p class="pkg-name mb-1">Essential</p>
                    <hr class="my-2" style="border-color:#e8e7e0;opacity:1;">
                    <div class="price-val mb-0" data-monthly="@essentialPrice!.MonthlyPrice" data-annually="@essentialPrice!.AnnualPrice">
                        @if (selectedBillingtype == BillingType.Annually)
                        {
                            @essentialPrice!.AnnualPrice
                        }
                        else if (selectedBillingtype == BillingType.Monthly)
                        {
                            @essentialPrice!.MonthlyPrice
                        }
                        <span>
                            /Month
                        </span>
                    </div>
                    <hr class="my-2" style="border-color:#e8e7e0;opacity:1;">
                    <ul class="feature-list mb-3">
                        <li><span class="check-dot check-gray"><i class="fa-solid fa-check check-icon" aria-hidden="true"></i></span>Up to 10 Qualified Profile Views / Day</li>
                        <li><span class="check-dot check-gray"><i class="fa-solid fa-check check-icon" aria-hidden="true"></i></span>Up to 300 Impressions / Day</li>

                    </ul>

                    <div class="mt-auto">
                        <button class="btn-pkg" @onclick='@(() => OpenModal(PackageType.Essential))'>
                            Get Started
                        </button>
                    </div>
                </div>
            </div>
            <!-- Premium -->
            <div class="col-12 col-md-3">
                <div class="pkg-card featured p-4">
                    <span class="popular-badge">Most popular</span>
                    <p class="pkg-name mb-1">Premium</p>

                    <hr class="my-2" style="border-color:#e8e7e0;opacity:1;">

                    <div class="price-val mb-0" data-monthly="@premiumPrice!.MonthlyPrice" data-annually="@premiumPrice!.AnnualPrice">
                        @if (selectedBillingtype == BillingType.Annually)
                        {
                            @premiumPrice!.AnnualPrice
                        }
                        else if (selectedBillingtype == BillingType.Monthly)
                        {
                            @premiumPrice!.MonthlyPrice
                        }
                        <span>/Month</span>
                    </div>
                    <hr class="my-2" style="border-color:#e8e7e0;opacity:1;">
                    <ul class="feature-list mb-3">
                        <li><span class="check-dot check-teal"><i class="fa-solid fa-check check-icon" aria-hidden="true"></i></span>Up to 25 Qualified Profile Views / Day</li>
                        <li><span class="check-dot check-teal"><i class="fa-solid fa-check check-icon" aria-hidden="true"></i></span>Up to 750 Impressions / Day</li>

                    </ul>

                    <div class="mt-auto">
                        <button class="btn-pkg-primary" @onclick='@(() => OpenModal(PackageType.Premium))'>
                            Get Started
                        </button>
                    </div>
                </div>
            </div>
            <!-- Enterprise -->
            <div class="col-12 col-md-3">
                <div class="pkg-card p-4">
                    <p class="pkg-name mb-1">Enterprise</p>

                    <hr class="my-2" style="border-color:#e8e7e0;opacity:1;">
                    <p class="price-val mb-0">Custom Pricing</p>
                    <hr class="my-2" style="border-color:#e8e7e0;opacity:1;">
                    <ul class="feature-list mb-3">
                        <li><span class="check-dot check-purple"><i class="fa-solid fa-check check-icon" aria-hidden="true"></i></span>Custom Qualified Profile Views</li>
                        <li><span class="check-dot check-purple"><i class="fa-solid fa-check check-icon" aria-hidden="true"></i></span>Custom Impressions </li>
                    </ul>

                    <div class="mt-auto">
                        <button class="btn-pkg" @onclick='@(() => OpenModal(PackageType.Enterprise))'>
                            Get Started
                        </button>
                    </div>
                </div>
            </div>

        </div><!-- /row -->
        @*             <p class="text-center footer-note mt-4 mb-0">All plans include a 14-day free trial. No credit card required. Cancel anytime.</p>
 *@        </div><!-- /container -->
</section>
<section class="container mt-5">
    <div class="comparison-table mx-2 text-center pt-5">
