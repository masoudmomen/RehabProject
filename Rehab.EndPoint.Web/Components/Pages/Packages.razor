                    <td class="check">✓</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                </tr>

                <tr>
                    <td>Facility Phone Number</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                </tr>

                <tr>
                    <td>Enhanced Facility Profile</td>
                    <td class="dash">—</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                </tr>

                <tr>
                    <td>Photo Gallery</td>
                    <td class="dash">—</td>
                    <td>10 Photos</td>
                    <td>25 Photos</td>
                    <td>50 Photos</td>
                </tr>

                <tr>
                    <td>Facility Highlights</td>
                    <td class="dash">—</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                </tr>

                <tr>
                    <td>Appears in Relevant Searches & Filters</td>
                    <td class="dash">—</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                </tr>

                <tr>
                    <td>Featured Search Placement</td>
                    <td class="dash">—</td>
                    <td class="dash">—</td>
                    <td class="check">✓</td>
                    <td class="check">✓</td>
                </tr>

                <tr>
                    <td>Featured Blog Article</td>
                    <td class="dash">—</td>
                    <td class="dash">—</td>
                    <td class="dash">—</td>
                    <td class="check">✓</td>
                </tr>
            </tbody>


        </table>
    </div>
</section>
<section class="container">
    <div class="claim-panel">
        <h2>It’s <span>free</span> to be listed</h2>
        <p>
            Search for your facility below. If your profile already exists, you can claim it.
            If it is not listed yet, submit your facility information and we will help you get started.
        </p>

        <div class="search-box">
            <input type="text" placeholder="Enter your facility name" />
            <button type="button">Search</button>
        </div>
    </div>
</section>
<PackagesModalComponent Visible="@showModal"
                        VisibleChanged="v => showModal = v"
                        PackageType="@selectedPackage"
                        BillingType="@selectedBillingtype" />

<ClaimFormModalComponent />
@code {
    private bool showModal = false;
    private PackageType selectedPackage;

    private BillingType selectedBillingtype = BillingType.Monthly;
    private IEnumerable<PackagePriceDto>? packagePrices;

    private PackagePriceDto? essentialPrice;
    private PackagePriceDto? premiumPrice;

    // private string basicMonthlyPrice = "499";
    // private string basicannuallyPrice = "399";

    // private string premiumMonthlyPrice = "1,099";
    // private string premiumannuallyPrice = "999";

    private string billingDescription = "Aannual plans include preferred pricing";


    void OpenModal(PackageType package)
    {
        selectedPackage = package;
        showModal = true;
    }

    private async Task HandleSubmit(PackageRequestViewModel model)
    {
    }


    private string? Keywords;
    private string? Description;
    private void LoadMeta()
    {
        var Meta = SeoService.GetMeta("Plans&Pricing");

        if (Meta != null)
        {
            if (Meta.Keywords != null)
                Keywords = string.Join(",", Meta.Keywords);

            Description = Meta.Description;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LoadMeta();
        packagePrices = await PackagePricingService.GetAllPricesAsync();
        essentialPrice = packagePrices.FirstOrDefault(p => p.packageType == PackageType.Essential);
        premiumPrice = packagePrices.FirstOrDefault(p => p.packageType == PackageType.Premium);
    }


}
