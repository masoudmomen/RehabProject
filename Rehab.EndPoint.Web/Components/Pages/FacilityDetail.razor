@page "/facility/{slug}"
@* @page "/facility/{id}" *@
@using Rehab.Application.Facilities
@using Rehab.EndPoint.Web.ViewModels
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.EndPoint.Web.Components.Facility
@inject IFacilityService FacilityService
@inject AutoMapper.IMapper mapper


<div>
    @if (facility != null)
    {

        <PageTitle>@facility.Name</PageTitle>

        @* Redesign (final design, option C) — section 1: breadcrumb + header card *@
        <div class="facility-page-top">
            <div class="container">
                <BreadCrumbComponent Items="@breadCrumbItems" />
                <FacilityHeader @rendermode="InteractiveServer" Facility="@facility" ServerUrl="@(serverUrl ?? string.Empty)" />

                @* Section 2: quick answers row *@
                <FacilityServicesRow Facility="@facility" />

                @* Section 3: main content row — collapsible sections + "Insurance accepted" sidebar *@
                <FacilityContent Facility="@facility" ServerUrl="@(serverUrl ?? string.Empty)" />
            </div>
        </div>
    }
</div>
@code {
    [Parameter] public string slug { get; set; } = string.Empty;
    // [Parameter] public string id { get; set; } = string.Empty;
    private FacilityViewModel? facility;
    private bool isLoading = true;

    [Inject] IConfiguration Config { get; set; } = default!;

    private string? serverUrl;


    // protected override void OnInitialized()
    // {
    //     if (!string.IsNullOrEmpty(slug))
    //     {
    //         if (!string.IsNullOrWhiteSpace(slug))
    //         {
    //             facility = MockFacilityData.GetSampleFacilities()
    //                        .FirstOrDefault(f => string.Equals(f.Slug, slug, StringComparison.OrdinalIgnoreCase)
    //                        || string.Equals(ToSlug(f.Name), slug, StringComparison.OrdinalIgnoreCase));
    //         }
    //     }

    //     isLoading = false;
    // }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(slug))
        {
            facility = mapper.Map<FacilityViewModel>(FacilityService.FindBySlug(slug));
        }
        isLoading = false;
        serverUrl = Config["AppSettings:AdminServerUrl"];
        breadCrumbItems = BuildBreadCrumb(facility);
    }

    private List<BreadCrumbComponent.BreadCrumbItem> breadCrumbItems = new();

    // Home › Treatment Centers › State › Center (state is skipped when the center has none)
    private static List<BreadCrumbComponent.BreadCrumbItem> BuildBreadCrumb(FacilityViewModel? f)
    {
        var items = new List<BreadCrumbComponent.BreadCrumbItem>
        {
            new() { Text = "Home", Href = "/" },
            new() { Text = "Treatment Centers", Href = "/treatment-centers" },
        };
        if (f is null) return items;

        if (!string.IsNullOrWhiteSpace(f.State))
            items.Add(new() { Text = f.State, Href = $"/States/{Uri.EscapeDataString(f.State)}" });

        items.Add(new() { Text = f.Name, IsActive = true });
        return items;
    }

    // private static string ToSlug(string? value)
    // {
    //     if (string.IsNullOrWhiteSpace(value)) return string.Empty;
    //     return System.Text.RegularExpressions.Regex.Replace(value.Trim(), "\\s+", "-");
    // }

}

