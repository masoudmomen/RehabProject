@page "/about-us/our-story"
@* @rendermode InteractiveServer *@
@inject IJSRuntime jSRuntime
@using Microsoft.AspNetCore.Components.Web
@using Rehab.EndPoint.Web.Components.Common

@using Rehab.Application.Seo
@inject ISeoService SeoService


<HeadContent>
    <meta name="keywords" content="@Keywords" />
    <meta name="description" content="@Description" />
</HeadContent>

<Seo Title="About us - Our story"
     Description="Learn about Rehab's mission, values, and the team behind our innovative solutions."
     CanonicalUrl="https://Rehabnavigator.com/about-us"
     FaviconUrl="favicon.png" />
<div class="container py-3">
    <HeroSectionComponent SectionTitle="Explore Rehab and Mental Health Treatment Approaches"
                          SectionSubtitle=" RehabNavigator helps individuals, families, and loved ones review treatment center profiles, compare available provider information, and explore recovery-related resources by organizing details such as location, conditions treated, levels of care, insurance, treatment approaches, populations served, amenities, and facility contact options." />
</div>
<section class="section bg-soft-blue" id="Why-we-exist">
    <div class="container d-flex justify-content-center">
        <div class="d-flex align-items-center overflow-hidden p-5 rounded-2 top-border-gradient bg-white position-relative ourstory-container">
            <div class="col col-md-5">
                <img src="/images/facility_card_placeholder.jpg"
                     class="img-fluid rounded-4 shadow-sm"
                     alt="Example of a facility card layout showing image, name, location, and features"
                     loading="lazy" />
            </div>
            <div class="col col-md-7 ps-2">
                <h2 style="text-align:left">
                    Searching for treatment should feel clearer.
                </h2>
                <p>
                    Looking for addiction treatment, mental health care, or recovery support can feel overwhelming. Information is often scattered across different websites, provider details may vary, and comparing available options is not always simple.

                    RehabNavigator exists to organize treatment information in one place, making it easier to explore provider profiles, review treatment options, and compare facilities using clear search tools and recovery resources.

                    Our role is to help people browse, filter, compare, and contact treatment providers directly. RehabNavigator is a directory and information platform, not a treatment provider
                </p>
            </div>
        </div>
    </div>
</section>
<section class="section" id="What-you-can-do">
    <div class="container text-center">
        <div class="section-text-content">
            <span class="badge-custome">
                Explore RehabNavigator
            </span>
            <h2>Find the information that fits your search.</h2>
            <p>RehabNavigator connects major parts of the treatment search into one organized experience.</p>
        </div>
        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon">
                    <i class="bi bi-hospital"></i>
                </div>
                <h3>Treatment Centers</h3>
                <p class="small-text">Browse treatment center profiles by location, condition, insurance, level of care, treatment approach, population, and amenities.</p>
                <a class="" target="_blank" href="/treatmentsList">Browse Centers</a>
            </div>

            <div class="value-card">
                <div class="value-icon">
                    <i class="bi bi-clipboard2-pulse"></i>
                </div>
                <h3>
                    Conditions & Concerns
                </h3>
                <p class="small-text">Explore simple explanations of mental health conditions, substance use concerns, and behavioral health topics.</p>
                <a class="" target="_blank" href="/ConditionsList">View Conditions</a>
            </div>

            <div class="value-card">
                <div class="value-icon">
                    <i class="bi bi-bandaid"></i>
                </div>
                <h3>
                    Treatment Approaches
                </h3>
                <p class="small-text">Explore therapy models, counseling methods, medication-supported care, and wellness approaches used in treatment.</p>
                <a class="" target="_blank" href="/treatmentsList">View Approaches</a>
            </div>

            <div class="value-card">
                <div class="value-icon">
                    <i class="bi bi-layers"></i>
                </div>
                <h3>
                    Levels of Care
                </h3>
                <p class="small-text">Understand detox, residential treatment, PHP, IOP, outpatient care, virtual care, sober living, and related supports.</p>
                <a class="" target="_blank" href="/#">View Levels</a>
            </div>
            <div class="value-card">
                <div class="value-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h3>
                    Insurance Information
                </h3>
                <p class="small-text">Review insurance details when listed by providers and confirm coverage directly with the facility or insurer.</p>
                <a class="" target="_blank" href="/#">Search by Insurance</a>
            </div>
            <div class="value-card">
                <div class="value-icon">
                    <i class="bi bi-question-circle"></i>
                </div>
                <h3>
                    Treatment FAQ & Resources
                </h3>
                <p class="small-text">Read common questions about rehab, detox, insurance, work, recovery, relapse, privacy, and levels of care.</p>
                <a class="" target="_blank" href="/Treatment-faq">Read FAQ</a>
            </div>
        </div>
    </div>

</section>
<section class="section bg-soft-blue" id="Platform-reveiew">
    <div class="container">
        <div class="row d-flex justify-content-center bg-white p-5 rounded-4 shadow">
            <div class="col-12 col-md-6">
                <span class="badge-custome">
                    Platform Preview
                </span>
                <h2 style="text-align:left">
                    Built around how people actually search.
                </h2>
                <p>
                    People do not all search for treatment the same way. Some start with location. Others start with a condition, level of care, treatment approach, insurance plan, or population served.
                </p>
                <p>
                    RehabNavigator is structured to support those different paths while keeping facility information organized and easy to compare.
                </p>
            </div>

            <div class="col-12 col-md-6">
                <div aria-label="Directory interface preview" class="mockup px-2">
                    <img src="/images/listing_page_placeholder.jpg"
                         class="img-fluid rounded-4 shadow-sm w-100"
                         alt="Preview of the directory search and listing interface, showing filters and facility cards"
                         loading="lazy"
                         width="980" height="740" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container text-center">

        <span class="badge-custome">
            Our values
        </span>
        <h2>Clear. <span class="text-secondary-blue">Respectul. </span> Useful.</h2>
        <p>Every part of RehabNavigator is designed to make treatment information easier to review, compare, and navigate.</p>
        <div class="cards-grid">
            <div class="card"><div class="card-icon icon-1"><i class="bi bi-eye"></i></div><p class="card-title">Clarity</p></div>
            <div class="card"><div class="card-icon icon-2"><i class="bi bi-shield-check"></i></div><p class="card-title">Transparency</p></div>
            <div class="card"><div class="card-icon icon-3"><i class="bi bi-universal-access"></i></div><p class="card-title">Accessibility</p></div>
            <div class="card"><div class="card-icon icon-4"><i class="bi bi-hand-thumbs-up"></i></div><p class="card-title">Responsibility</p></div>
        </div>

    </div>
</section>
<section class="section bg-soft-blue">
    <div class="container py-5 d-flex justify-content-center">
        <div class="directory-quality">
            <div class="row align-items-center g-5">

                <!-- Left column: text -->
                <div class="col-lg-6">
                    <span class="badge-custome">
                        Our Directory Standards
                    </span>
                    <h2 class="dq-headline mb-3" style="text-align:left">Organized so information is easier to review.</h2>
                    <p class="dq-desc mb-0">Facility profiles are structured with consistent categories so visitors can scan and compare available information more easily before contacting providers directly.</p>
                </div>

                <!-- Right column: feature list -->
                <div class="col-lg-6">
                    <div class="feature-card-container">

                        <div class="dq-feature-card d-flex align-items-center gap-3">
                            <div class="dq-check-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <p class="dq-feature-text mb-0">Facility Information</p>
                        </div>

                        <div class="dq-feature-card d-flex align-items-center gap-3">
                            <div class="dq-check-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <p class="dq-feature-text mb-0">
                                Levels of Care
                            </p>
                        </div>

                        <div class="dq-feature-card d-flex align-items-center gap-3">
                            <div class="dq-check-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <p class="dq-feature-text mb-0">Treatment Approaches</p>
                        </div>

                        <div class="dq-feature-card d-flex align-items-center gap-3">
                            <div class="dq-check-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <p class="dq-feature-text mb-0">Conditions Treated</p>
                        </div>
                        <div class="dq-feature-card d-flex align-items-center gap-3">
                            <div class="dq-check-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <p class="dq-feature-text mb-0">Insurance Information</p>
                        </div>
                        <div class="dq-feature-card d-flex align-items-center gap-3">
                            <div class="dq-check-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <p class="dq-feature-text mb-0">Amenities</p>
                        </div>
                        <div class="dq-feature-card d-flex align-items-center gap-3">
                            <div class="dq-check-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <p class="dq-feature-text mb-0">Accreditations</p>
                        </div>
                        <div class="dq-feature-card d-flex align-items-center gap-3">
                            <div class="dq-check-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <p class="dq-feature-text mb-0">Contact Information</p>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
 
<FAQComponent ></FAQComponent>


<section class="cta" id="next-steps">
    <div class="container">
        <h2>Ready to start exploring?</h2>
        <p>Explore treatment centers, review conditions, compare treatment approaches, understand levels of care, and discover recovery resources.</p>
        <div class="cta-actions">
            <a class="cta-primary" target="_blank" href="/treatmentsList">Browse Treatment Centers</a>
            <a class="cta-secondary" target="_blank"  href="/Treatment-faq">Read Treatment FAQ</a>
        </div>
    </div>
</section>
@code {
    private string? Keywords;
    private string? Description;
    private void LoadMeta()
    {
        var Meta = SeoService.GetMeta("OurStory");

        if (Meta != null)
        {
            if (Meta.Keywords != null)
                Keywords = string.Join(",", Meta.Keywords);

            Description = Meta.Description;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LoadMeta();
    }


    int count = 0;

    private IJSObjectReference? jsModule;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("About Us page rendered for the first time.");
            jsModule = await jSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/animation.js");
            await jsModule.InvokeVoidAsync("initPageAnimations");
        }

    }
    async Task ShowAlert()
    {
        await jSRuntime.InvokeVoidAsync(identifier: "createAlert");
    }

}
