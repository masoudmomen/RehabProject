@page "/ConditionsList"
@* @rendermode InteractiveServer *@
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.EndPoint.Web.ViewModels
@using AutoMapper
@using Rehab.Application.Conditions
@inject IConditionService ConditionService
@inject IMapper mapper;
@* @inject IJSRuntime JS; *@
@using Rehab.Application.Seo
@inject ISeoService SeoService


<HeadContent>
    <meta name="keywords" content="@Keywords" />
    <meta name="description" content="@Description" />
</HeadContent>

<div class="container">
    <HeroSectionComponent 
        SectionTitle="Explore Mental Health Conditions and Addiction Concerns"
        SectionSubtitle="Explore simple explanations of mental health, substance use, and behavioral health concerns.">
    </HeroSectionComponent>
 
    <input type="checkbox" id="sidebarToggle" hidden />
    <div class="sidebar-overlay"></div>
    <div class="row my-4 layout-wrapper">
        <h3 class="section-title">
            Conditions & Concerns
        </h3>
        <div class="content-a">
            @*  <h2 class="page-title">Conditions</h2> *@

            <div class="input-group search-conditions-box" id="searchbox">
                <input type="text"
                       class="form-control border-0 p-2 fs-7"
                       placeholder="Search Conditions & Concerns by Name" />
                <button class="btn search-btn" type="button" id="btnSearch">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            <div class="top-conditions mt-4">
                <h3 class="section-title">
                    Popular Conditions & Concerns
                </h3>
                <p class="fs-6 text-muted">
                    Use these quick links to jump to common concerns, or search the full list below.
                </p>
                <div class="row mb-3 px-0 align-items-stretch">
                    @foreach (var card in SpecialConditions)
                    {
                        <div class="col-12 col-md-3 mb-2">
                            <ConditionCardComponent Card="card"
                                                    CharacterLimit="120"
                                                    CustomClass="special"
                                                    prefixImageURL="@serverUrl" />
                        </div>
                    }
                </div>

            </div>
            <div class="all-conditon mt-4">
                <h3 class="section-title">
                    All Conditions & Concerns
                </h3>
                <p class="fs-6 text-muted">
                    Read a simple explanation, then choose View Centers to browse treatment center profiles filtered by that concern.
                </p>

                <div class="row mb-3 px-0 align-items-stretch">
                    @foreach (var card in AllConditions)
                    {
                        <div class="col-12 col-md-3 mb-2">
                            <ConditionCardComponent Card="card"
                                                    CustomClass=""
                                                    CharacterLimit="120"
                                                    prefixImageURL="@serverUrl" />
                        </div>
                    }
                </div>

            </div>
            <BrowsTreatmentCentersComponent />

        </div>
        <div class="content-b">
            <SidebarComponent />
        </div>

    </div>
</div>
@code {
    private List<CardViewModel> SpecialConditions = new();
    private List<CardViewModel> AllConditions = new();
    private string? serverUrl;
    [Inject] IConfiguration Config { get; set; } = default!;

    private string? Keywords;
    private string? Description;
    private void LoadMeta()
    {
        var Meta = SeoService.GetMeta("ConditionsList");

        if (Meta != null)
        {
            if (Meta.Keywords != null)
                Keywords = string.Join(",", Meta.Keywords);

            Description = Meta.Description;
        }
    }

    protected override void OnInitialized()
    {
        serverUrl = Config["AppSettings:AdminServerUrl"];
        SpecialConditions = mapper.Map<List<CardViewModel>>(ConditionService.GetList().Take(4));
        AllConditions = mapper.Map<List<CardViewModel>>(ConditionService.GetList());
    }
}
<style>
    .section-title::after {
        display: none
    }
</style>