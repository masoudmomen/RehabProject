@page "/blog/{Slug}"
@using Microsoft.AspNetCore.Http
@using Rehab.EndPoint.Web.Components.Common
@using Rehab.EndPoint.Web.ViewModels
@using Rehab.Application.Blog
@using AutoMapper
@inject IBlogPostService PostService
@inject IMapper Mapper
@inject IHttpContextAccessor HttpContextAccessor
<div class="container">
  
    <div class="row">
        <div class="col-12 col-md-9 pt-4">
            <BlogPostDetail article="_article"></BlogPostDetail>
        </div>
        <div class="col-12 col-md-3 mt-4">
            <a href="/blog" class="back-link">
                <span class="icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
                </span>
                Back to Blog
            </a>
            <div class="related-head">
            <h6 class="mb-3">Related Articles</h6>
            </div>
            @if (RelatedPosts != null && RelatedPosts.Count > 0)
            {
                @foreach (var post in RelatedPosts)
                {
                    <BlogPostSmallCard Article="post" />
                }
            }

        </div>
    </div>
</div>

<BlogSubscribe></BlogSubscribe>
@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;
    private BlogPostDetailViewModel? _article;
    private int articleId = 0;
    private bool _notFound;
    private List<BlogPostCardViewModel> RelatedPosts = new();
    [Inject] IConfiguration Config { get; set; } = default!;
    private string? serverUrl;
    protected override Task OnInitializedAsync()
    {
        serverUrl = Config["AppSettings:AdminServerUrl"];

        return base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        _article = null;
        _notFound = false;
        var result = await PostService.GetPostDetailBySlugAsync(Slug);

        if (result is null)
        {
            _notFound = true;
            return;
        }
        var dto = result.Data;
        _article = Mapper.Map<BlogPostDetailViewModel>(dto);
        articleId = _article.Id;

        await TryCountViewAsync();

        var relatedResult = await PostService.GetRelatedPostsAsync(articleId);
        if (relatedResult is null)
            return;

        RelatedPosts = Mapper.Map<List<BlogPostCardViewModel>>(relatedResult.Data);
    }

   
    private async Task TryCountViewAsync()
    {
        if (articleId <= 0)
            return;

        var http = HttpContextAccessor.HttpContext;
        if (http is null)
            return;

        var cookieName = $"bv{articleId}";

        var counted = await PostService.TryRecordViewAsync(new BlogViewRequest
        {
            PostId = articleId,
            UserAgent = http.Request.Headers.UserAgent.ToString(),
            IsPreview = http.Request.Query.ContainsKey("preview"),
            AlreadyCounted = http.Request.Cookies.ContainsKey(cookieName)
        });

        if (counted && !http.Response.HasStarted)
        {
            http.Response.Cookies.Append(cookieName, "1", new CookieOptions
            {
                HttpOnly = true,
                IsEssential = true, // functional, non-tracking -> exempt from consent gating
                Secure = http.Request.IsHttps,
                SameSite = SameSiteMode.Lax,
                MaxAge = TimeSpan.FromHours(12)
            });
        }
    }

}
